{
  "name": "mcis-tests",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "engines": {
    "npm": "use bun instead - see CLAUDE.md",
    "yarn": "use bun instead - see CLAUDE.md",
    "pnpm": "use bun instead - see CLAUDE.md"
  },
  "scripts": {
    "preinstall": "npx only-allow bun",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui",
    "test:database": "tsx unit/utils/database-test-runner.ts",
    "test:database:core": "vitest run unit/utils/database.test.ts",
    "test:database:edge": "vitest run unit/utils/database-edge-cases.test.ts",
    "test:database:errors": "vitest run unit/utils/database-error-handling.test.ts",
    "test:database:performance": "vitest run unit/utils/database-performance.test.ts",
    "test:database:coverage": "vitest run unit/utils/database*.test.ts --coverage",
    "test:database:watch": "vitest unit/utils/database*.test.ts --watch",
    "test:line": "tsx run-line-tests.ts",
    "test:line:watch": "vitest unit/utils/line*.test.ts --watch",
    "test:line:coverage": "vitest run unit/utils/line*.test.ts --coverage",
    "test:conversation": "vitest run unit/handlers/conversation*.test.ts",
    "test:conversation:core": "vitest run unit/handlers/conversation.test.ts",
    "test:conversation:edge": "vitest run unit/handlers/conversation-edge-cases.test.ts",
    "test:conversation:performance": "vitest run unit/handlers/conversation-performance.test.ts",
    "test:conversation:integration": "vitest run unit/handlers/conversation-integration.test.ts",
    "test:conversation:coverage": "vitest run unit/handlers/conversation*.test.ts --coverage",
    "test:conversation:watch": "vitest unit/handlers/conversation*.test.ts --watch",
    "test:message": "vitest run unit/handlers/message*.test.ts",
    "test:message:core": "vitest run unit/handlers/message.test.ts",
    "test:message:edge": "vitest run unit/handlers/message-edge-cases.test.ts",
    "test:message:performance": "vitest run unit/handlers/message-performance.test.ts",
    "test:message:integration": "vitest run unit/handlers/message-integration.test.ts",
    "test:message:coverage": "vitest run unit/handlers/message*.test.ts --coverage",
    "test:message:watch": "vitest unit/handlers/message*.test.ts --watch",
    "test:handlers": "vitest run unit/handlers/*.test.ts",
    "test:handlers:coverage": "vitest run unit/handlers/*.test.ts --coverage",
    "test:handlers:watch": "vitest unit/handlers/*.test.ts --watch",
    "test:services": "vitest run unit/services/*.test.ts",
    "test:services:core": "vitest run unit/services/permission.test.ts",
    "test:services:edge": "vitest run unit/services/permission-edge-cases.test.ts",
    "test:services:performance": "vitest run unit/services/permission-performance.test.ts",
    "test:services:integration": "vitest run unit/services/permission-integration.test.ts",
    "test:services:coverage": "vitest run unit/services/*.test.ts --coverage",
    "test:services:watch": "vitest unit/services/*.test.ts --watch"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.0.0",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/core": "^10.7.0",
    "jsdom": "^26.1.0",
    "pinia": "^2.1.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.3",
    "vitest": "^2.0.0",
    "vue": "^3.4.0",
    "vue-i18n": "^11.1.11",
    "vue-router": "^4.2.0"
  }
}
