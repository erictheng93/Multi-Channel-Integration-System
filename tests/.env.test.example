# Test Environment Configuration
# Copy to .env.test and fill in actual values

# Test Database
TEST_DATABASE_URL=file:./test.db

# Test API Base URL
TEST_BASE_URL=http://localhost:8787

# Test User Credentials (use dedicated test accounts)
TEST_ADMIN_EMAIL=test-admin@example.com
TEST_ADMIN_PASSWORD=secure-test-password-123

TEST_AGENT_EMAIL=test-agent@example.com  
TEST_AGENT_PASSWORD=secure-test-password-456

# JWT Secret for testing
TEST_JWT_SECRET=test-jwt-secret-key-for-testing-only