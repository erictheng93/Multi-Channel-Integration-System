{
  "environments": {
    "local": {
      "baseUrl": "http://localhost:8787",
      "description": "本地開發環境"
    },
    "dev": {
      "baseUrl": "https://multi-channel.imfinethankyouandyou.com",
      "description": "開發環境 (使用生產 API)"
    },
    "prod": {
      "baseUrl": "https://multi-channel.imfinethankyouandyou.com",
      "description": "生產環境"
    }
  },
  "testSettings": {
    "timeout": 10000,
    "retries": 3,
    "concurrency": 5,
    "loadTestDuration": 30
  },
  "testUsers": {
    "admin": {
      "username": "admin@example.com",
      "password": "admin123",
      "role": "admin"
    },
    "agent": {
      "username": "agent@example.com",
      "password": "agent123",
      "role": "agent"
    },
    "testUser": {
      "username": "test@example.com",
      "password": "test123",
      "role": "agent"
    }
  },
  "endpoints": {
    "health": [
      "/",
      "/api/health"
