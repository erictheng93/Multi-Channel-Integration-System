{
  "description": "Authoritative list of /api registrations that must run before RouteRegistry in src/index.ts. Keep this in source order.",
  "preRegistry": [
    { "method": "USE", "route": "/api/*", "category": "system", "access": "middleware", "reason": "Metrics middleware must wrap API traffic before route handlers." },
    { "method": "USE", "route": "/api/websocket/metrics", "category": "auth", "access": "auth", "reason": "Protect sensitive WebSocket metrics while leaving health endpoints public." },
    { "method": "USE", "route": "/api/websocket/health-detail", "category": "auth", "access": "auth", "reason": "Protect detailed WebSocket diagnostics." },
    { "method": "ROUTE", "route": "/api/websocket", "category": "public", "access": "public", "reason": "WebSocket health/readiness/liveness must be reachable before catch-all handlers." },
    { "method": "ROUTE", "route": "/api/websocket", "category": "auth", "access": "mixed", "reason": "WebSocket connect/disconnect must mount after health and before unified routes." },
    { "method": "GET", "route": "/api/delayed-messages-v2/health", "category": "public", "access": "public", "reason": "Delayed message health is a public operational probe." },
    { "method": "GET", "route": "/api/system/config-check", "category": "admin", "access": "admin", "reason": "Config check is admin-only and must not be shadowed." },
    { "method": "ROUTE", "route": "/api/ops/drills", "category": "ops", "access": "staging-token", "reason": "Staging-only operational drills must run before generic auth catch-all routes." },
    { "method": "GET", "route": "/api/r2-public/:folder/:filename", "category": "proxy", "access": "signed-public", "reason": "Signed R2 proxy must be mounted before file catch-all routes." },
    { "method": "OPTIONS", "route": "/api/r2-public/:folder/:filename", "category": "proxy", "access": "public", "reason": "R2 proxy CORS preflight must match the signed proxy route." },
    { "method": "USE", "route": "/api/analytics/comparison/*", "category": "auth", "access": "auth", "reason": "Comparison API auth middleware must run before its route mount." },
    { "method": "ROUTE", "route": "/api/analytics/comparison", "category": "auth", "access": "auth", "reason": "Comparison routes must not be intercepted by analytics catch-all routes." },
    { "method": "ROUTE", "route": "/api/monitoring/kv", "category": "admin", "access": "admin", "reason": "KV optimization routes have their own access policy and priority." },
    { "method": "ROUTE", "route": "/api/monitoring", "category": "monitoring", "access": "mixed", "reason": "Monitoring health and admin endpoints must keep existing priority." },
    { "method": "USE", "route": "/api/cors/stats", "category": "auth", "access": "auth", "reason": "Protect CORS stats before public CORS route mount." },
    { "method": "USE", "route": "/api/cors/events", "category": "auth", "access": "auth", "reason": "Protect CORS events before public CORS route mount." },
    { "method": "USE", "route": "/api/cors/rejected-origins", "category": "auth", "access": "auth", "reason": "Protect rejected-origin details before public CORS route mount." },
    { "method": "USE", "route": "/api/cors/cleanup", "category": "admin", "access": "admin", "reason": "Protect CORS cleanup before public CORS route mount." },
    { "method": "ROUTE", "route": "/api/cors", "category": "public", "access": "mixed", "reason": "CORS health/config must remain public before unified routes." },
    { "method": "ROUTE", "route": "/api/security", "category": "security", "access": "mixed", "reason": "Security health plus protected endpoints keep explicit priority." },
    { "method": "ROUTE", "route": "/api/security/dashboard", "category": "security", "access": "mixed", "reason": "Security dashboard has a dedicated router and stream endpoint." },
    { "method": "ROUTE", "route": "/api/kv", "category": "admin", "access": "mixed", "reason": "KV management routes must keep existing priority." },
    { "method": "ROUTE", "route": "/api/files", "category": "proxy", "access": "public", "reason": "Public file proxy must not be shadowed by authenticated file routes." },
    { "method": "ROUTE", "route": "/api/admin/migrations", "category": "admin", "access": "admin", "reason": "Admin migration endpoints must not be shadowed by catch-all routes." },
    { "method": "POST", "route": "/api/webhook", "category": "webhook", "access": "signature", "reason": "LINE webhook uses signature verification, not JWT." },
    { "method": "GET", "route": "/api/webhook", "category": "webhook", "access": "public", "reason": "Webhook readiness endpoint is public." },
    { "method": "ALL", "route": "/api/webhooks/facebook", "category": "webhook", "access": "signature", "reason": "Facebook webhook uses platform verification, not JWT." },
    { "method": "USE", "route": "/api/websocket/dashboard/*", "category": "auth", "access": "auth", "reason": "Protect WebSocket dashboard before mount." },
    { "method": "ROUTE", "route": "/api/websocket/dashboard", "category": "admin", "access": "mixed", "reason": "WebSocket dashboard routes keep explicit priority." },
    { "method": "ROUTE", "route": "/api/customer-ws", "category": "websocket", "access": "mixed", "reason": "Customer WebSocket upgrade route must be mounted before unified routes." },
    { "method": "ROUTE", "route": "/api/customer-conversations", "category": "auth", "access": "auth", "reason": "Customer conversation message routes keep existing priority." },
    { "method": "USE", "route": "/api/channels", "category": "auth", "access": "auth", "reason": "Channel routes require base path auth middleware." },
    { "method": "USE", "route": "/api/channels/*", "category": "auth", "access": "auth", "reason": "Channel sub-routes require auth middleware." },
    { "method": "ROUTE", "route": "/api/channels", "category": "admin", "access": "mixed", "reason": "Channel management routes keep explicit priority." },
    { "method": "ROUTE", "route": "/api/liff", "category": "public", "access": "public", "reason": "LIFF routes are intentionally public for LINE users." },
    { "method": "ROUTE", "route": "/api/admin/liff-qr", "category": "admin", "access": "admin", "reason": "Admin LIFF QR generation has a dedicated router." },
    { "method": "ROUTE", "route": "/api/reminders", "category": "auth", "access": "mixed", "reason": "Task reminder routes keep explicit priority." }
  ],
  "postRegistry": [
    { "method": "USE", "route": "/api/modular/*", "category": "admin", "access": "admin", "reason": "Admin-only modular system routes are registered after RouteRegistry as direct methods." },
    { "method": "GET", "route": "/api/modular/status", "category": "admin", "access": "admin", "reason": "Direct modular system status endpoint." },
    { "method": "GET", "route": "/api/modular/modules", "category": "admin", "access": "admin", "reason": "Direct modular system module list endpoint." },
    { "method": "POST", "route": "/api/modular/modules", "category": "admin", "access": "admin", "reason": "Direct modular system module creation endpoint." },
    { "method": "GET", "route": "/api/modular/health", "category": "admin", "access": "admin", "reason": "Direct modular system health endpoint." },
    { "method": "GET", "route": "/api/monitoring/dashboard", "category": "admin", "access": "admin", "reason": "Admin monitoring dashboard endpoint." },
    { "method": "GET", "route": "/api/monitoring/health/history", "category": "admin", "access": "admin", "reason": "Admin monitoring health history endpoint." },
    { "method": "GET", "route": "/api/monitoring/alerts", "category": "admin", "access": "admin", "reason": "Admin monitoring alert history endpoint." },
    { "method": "PUT", "route": "/api/monitoring/config", "category": "admin", "access": "admin", "reason": "Admin monitoring config endpoint." },
    { "method": "POST", "route": "/api/monitoring/health/check", "category": "admin", "access": "admin", "reason": "Admin monitoring health trigger endpoint." },
    { "method": "GET", "route": "/api/monitoring/metrics", "category": "admin", "access": "admin", "reason": "Admin monitoring metrics endpoint." },
    { "method": "GET", "route": "/api/monitoring/stats", "category": "admin", "access": "admin", "reason": "Admin monitoring stats endpoint." },
    { "method": "ROUTE", "route": "/api/system", "category": "fine-grained", "access": "mixed", "reason": "System settings router remains a direct fine-grained router." },
    { "method": "ROUTE", "route": "/api/credentials", "category": "fine-grained", "access": "auth", "reason": "Credentials router remains a direct fine-grained router." },
    { "method": "ROUTE", "route": "/api/auth", "category": "fine-grained", "access": "auth", "reason": "Password self-service router remains mounted under auth." },
    { "method": "ROUTE", "route": "/api/realtime", "category": "fine-grained", "access": "mixed", "reason": "Realtime router remains a direct fine-grained router." },
    { "method": "ROUTE", "route": "/api/activities", "category": "fine-grained", "access": "auth", "reason": "Activity handler remains direct." },
    { "method": "ROUTE", "route": "/api/feedback", "category": "fine-grained", "access": "mixed", "reason": "Customer feedback handler remains direct." },
    { "method": "ROUTE", "route": "/api/queues", "category": "fine-grained", "access": "admin", "reason": "Queue monitor router remains direct." },
    { "method": "ROUTE", "route": "/api/debug", "category": "debug", "access": "debug-only", "reason": "Debug token endpoint is conditional on securityConfig.debug.enabled." }
  ]
}
