// ==================== 認證 API ====================

// 用戶登入
app.post('/api/auth/login', rateLimit(10, 60 * 1000), async (c) => {
  try {
    const { username, password } = await c.req.json();
    
    if (!username || !password) {
      return c.json({ error: 'Username and password are required' }, 400);
    }

    // 驗證用戶
    const user = await authenticateUser(c.env.DB, username, password);
    
    if (!user) {
      return c.json({ error: 'Invalid username or password' }, 401);
    }

    // 生成 JWT
    const token = await signJWT(
      { 
        userId: user.id, 
        username: user.username, 
        role: user.role,
        teamId: user.teamId || undefined
      },
      c.env.JWT_SECRET,
      24 * 60 * 60 // 24 小時
    );

    // 創建會話（存儲在 KV）
    const sessionId = await createSession(
      c.env.SESSIONS,
      user.id,
      {
        username: user.username,
        role: user.role,
        teamId: user.teamId || undefined,
        loginAt: new Date().toISOString()
      }
    );

    return c.json({
      success: true,
      data: {
        user: {
          id: user.id,
          username: user.username,
          email: user.email,
          displayName: user.displayName,
          role: user.role,
          teamId: user.teamId || undefined,
          teamName: user.teamName
        },
        token,
        sessionId,
        expiresIn: 24 * 60 * 60
      },
      timestamp: new Date().toISOString()
    });

  } catch (error) {
    console.error('Login error:', error);
    return c.json({
      success: false,
      error: error instanceof Error ? error.message : 'Login failed',
      timestamp: new Date().toISOString()
    }, 500);
  }
});

// 用戶註冊（僅 admin 可以創建新用戶）
app.post('/api/auth/register', jwtAuth, requireRole('admin'), async (c) => {
  try {
    const { username, email, password, displayName, role, teamId } = await c.req.json();
    
    if (!username || !email || !password || !displayName || !role) {
      return c.json({ error: 'All fields are required' }, 400);
    }

    if (!['admin', 'agent'].includes(role)) {
      return c.json({ error: 'Invalid role' }, 400);
    }

    // 檢查用戶名是否已存在
    const existingUser = await c.env.DB.prepare(
      'SELECT id FROM users WHERE username = ? OR email = ?'
    ).bind(username, email).first();

    if (existingUser) {
      return c.json({ error: 'Username or email already exists' }, 409);
    }

    // 創建用戶
    const newUser = await createUser(c.env.DB, {
      username,
      email,
      password,
      displayName,
      role,
      teamId: teamId || null
    });

    return c.json({
      success: true,
      data: {
        user: {
          id: newUser.id,
          username: newUser.username,
          email: newUser.email,
          displayName: newUser.displayName,
          role: newUser.role,
          teamId: newUser.teamId,
          teamName: newUser.teamName
        }
      },
      timestamp: new Date().toISOString()
    });

  } catch (error) {
    console.error('Registration error:', error);
    return c.json({
      success: false,
      error: error instanceof Error ? error.message : 'Registration failed',
      timestamp: new Date().toISOString()
    }, 500);
  }
});

// 用戶登出
app.post('/api/auth/logout', sessionAuth, async (c) => {
  try {
    const sessionId = c.req.header('X-Session-ID');
    
    if (sessionId) {
      await c.env.SESSIONS.delete(`session:${sessionId}`);
    }

    return c.json({
      success: true,
      message: 'Logged out successfully',
      timestamp: new Date().toISOString()
    });

  } catch (error) {
    console.error('Logout error:', error);
    return c.json({
      success: false,
      error: error instanceof Error ? error.message : 'Logout failed',
      timestamp: new Date().toISOString()
    }, 500);
  }
});

