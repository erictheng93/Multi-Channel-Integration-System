            font-size: 1.1rem;
            font-weight: 600;
        }

        .btn {
            background: #4299e1;
            color: white;
            border: none;
            padding: 0.75rem 1.5rem;
            border-radius: 8px;
            cursor: pointer;
            font-size: 0.9rem;
            font-weight: 500;
            transition: all 0.2s;
            margin: 0.25rem;
        }

        .btn:hover {
            background: #3182ce;
            transform: translateY(-1px);
        }

        .btn-danger {
            background: #e53e3e;
        }

        .btn-danger:hover {
            background: #c53030;
        }

        .btn-success {
            background: #38a169;
        }

        .btn-success:hover {
            background: #2f855a;
        }

        .form-group {
            margin-bottom: 1rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 500;
            color: #4a5568;
        }

        .form-control {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            font-size: 0.9rem;
        }

        .form-control:focus {
            outline: none;
            border-color: #4299e1;
            box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.1);
        }

        .conversation-list {
            max-height: 400px;
            overflow-y: auto;
        }

        .conversation-item {
            padding: 1rem;
            border-bottom: 1px solid #e2e8f0;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .conversation-item:hover {
            background-color: #f7fafc;
        }

        .conversation-item.active {
            background-color: #ebf8ff;
            border-left: 4px solid #4299e1;
        }

        .customer-name {
            font-weight: 600;
            color: #2d3748;
        }

        .platform-badge {
            display: inline-block;
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 500;
            margin-left: 0.5rem;
        }

        .platform-line {
            background: #06d6a0;
            color: white;
        }

        .platform-facebook {
            background: #1877f2;
            color: white;
        }

        .status-badge {
            display: inline-block;
            padding: 0.25rem 0.5rem;
            border-radius: 4px;
            font-size: 0.75rem;
            font-weight: 500;
            margin-top: 0.25rem;
        }

        .status-active {
            background: #c6f6d5;
            color: #22543d;
        }

        .status-pending {
            background: #fed7d7;
            color: #742a2a;
        }

        .message-input {
            display: flex;
            gap: 0.5rem;
            margin-top: 1rem;
        }

        .message-input input {
            flex: 1;
        }

        .recall-controls {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-top: 0.5rem;
            padding: 0.75rem;
            background: #f7fafc;
            border-radius: 6px;
        }

        .recall-time {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .recall-time input {
            width: 80px;
        }

        .qr-code-display {
            text-align: center;
            padding: 1rem;
        }

        .qr-code-display img {
            max-width: 200px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
        }

        .team-selector {
            margin-bottom: 1rem;
        }

        .loading {
            text-align: center;
            padding: 2rem;
            color: #718096;
        }

        .error {
            background: #fed7d7;
            color: #742a2a;
            padding: 0.75rem;
            border-radius: 6px;
            margin-bottom: 1rem;
        }

        .success {
            background: #c6f6d5;
            color: #22543d;
            padding: 0.75rem;
            border-radius: 6px;
            margin-bottom: 1rem;
        }

        @media (max-width: 768px) {
            .dashboard-grid {
                grid-template-columns: 1fr;
            }
            
            .container {
                padding: 0 0.5rem;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>多渠道客服管理系統</h1>
    </div>

    <div class="container">
        <!-- 登入表單 -->
        <div id="loginForm" class="card" style="max-width: 400px; margin: 2rem auto;">
            <h3>系統登入</h3>
            <div class="form-group">
                <label>用戶名</label>
                <input type="text" id="username" class="form-control" placeholder="請輸入用戶名">
            </div>
            <div class="form-group">
                <label>密碼</label>
                <input type="password" id="password" class="form-control" placeholder="請輸入密碼">
            </div>
            <button onclick="login()" class="btn">登入</button>
            <div id="loginError" class="error" style="display: none;"></div>
        </div>

        <!-- 主要儀表板 -->
        <div id="dashboard" style="display: none;">
            <div class="dashboard-grid">
                <!-- 對話列表 -->
                <div class="card">
                    <h3>對話列表</h3>
                    <div class="team-selector">
                        <select id="teamFilter" class="form-control" onchange="loadConversations()">
                            <option value="">所有團隊</option>
                        </select>
                    </div>
                    <div id="conversationList" class="conversation-list">
                        <div class="loading">載入中...</div>
                    </div>
                </div>

                <!-- 訊息發送 -->
                <div class="card">
                    <h3>發送訊息</h3>
                    <div id="messagePanel">
                        <p>請選擇一個對話</p>
                    </div>
                </div>

                <!-- QR Code 管理 -->
                <div class="card">
                    <h3>QR Code 管理</h3>
                    <div class="form-group">
                        <label>選擇團隊</label>
                        <select id="qrTeamSelect" class="form-control">
                            <option value="">請選擇團隊</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>活動名稱 (可選)</label>
                        <input type="text" id="campaignName" class="form-control" placeholder="例如：春季促銷">
                    </div>
                    <div class="form-group">
                        <label>最大使用次數 (可選)</label>
                        <input type="number" id="maxUses" class="form-control" placeholder="留空表示無限制">
                    </div>
                    <button onclick="generateQRCode()" class="btn">生成 QR Code</button>
                    <div id="qrCodeDisplay" class="qr-code-display" style="display: none;"></div>
                </div>

                <!-- 團隊管理 -->
                <div class="card">
                    <h3>團隊管理</h3>
                    <div class="form-group">
                        <label>團隊名稱</label>
                        <input type="text" id="teamName" class="form-control" placeholder="請輸入團隊名稱">
                    </div>
                    <div class="form-group">
                        <label>團隊描述</label>
                        <input type="text" id="teamDescription" class="form-control" placeholder="請輸入團隊描述">
                    </div>
                    <button onclick="createTeam()" class="btn btn-success">創建團隊</button>
                    <div id="teamList" style="margin-top: 1rem;"></div>
                </div>
            </div>
        </div>
    </div>

    <script>
        let currentUser = null;
        let currentConversation = null;
        let authToken = null;

        // 登入功能
        async function login() {
            const username = document.getElementById('username').value;
            const password = document.getElementById('password').value;
            
            if (!username || !password) {
                showError('loginError', '請輸入用戶名和密碼');
                return;
            }

            try {
                const response = await fetch('/api/auth/login', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ username, password })
                });

                const result = await response.json();

                if (result.success) {
                    currentUser = result.data.user;
                    authToken = result.data.token;
                    
                    document.getElementById('loginForm').style.display = 'none';
                    document.getElementById('dashboard').style.display = 'block';
                    
                    await initDashboard();
                } else {
                    showError('loginError', result.error || '登入失敗');
                }
            } catch (error) {
                showError('loginError', '網路錯誤，請稍後再試');
            }
        }

        // 初始化儀表板
        async function initDashboard() {
            await loadTeams();
            await loadConversations();
        }

        // 載入團隊列表
        async function loadTeams() {
            try {
                const response = await fetch('/api/teams', {
                    headers: {
                        'Authorization': \`Bearer \${authToken}\`
                    }
                });

                const result = await response.json();
                if (result.success) {
                    const teams = result.data;
                    
                    // 更新團隊篩選器
                    const teamFilter = document.getElementById('teamFilter');
                    const qrTeamSelect = document.getElementById('qrTeamSelect');
                    
                    teamFilter.innerHTML = '<option value="">所有團隊</option>';
                    qrTeamSelect.innerHTML = '<option value="">請選擇團隊</option>';
                    
                    teams.forEach(team => {
                        teamFilter.innerHTML += \`<option value="\${team.id}">\${team.name}</option>\`;
                        qrTeamSelect.innerHTML += \`<option value="\${team.id}">\${team.name}</option>\`;
                    });

                    // 更新團隊列表
                    const teamList = document.getElementById('teamList');
                    teamList.innerHTML = teams.map(team => \`
                        <div style="padding: 0.5rem; border: 1px solid #e2e8f0; border-radius: 4px; margin-bottom: 0.5rem;">
                            <strong>\${team.name}</strong>
                            <p style="font-size: 0.8rem; color: #718096; margin: 0.25rem 0;">\${team.description || '無描述'}</p>
                            <span class="status-badge \${team.is_active ? 'status-active' : 'status-pending'}">
                                \${team.is_active ? '啟用' : '停用'}
                            </span>
                        </div>
                    \`).join('');
                }
            } catch (error) {
                console.error('載入團隊失敗:', error);
            }
        }

        // 載入對話列表
        async function loadConversations() {
            try {
                const response = await fetch('/api/conversations', {
                    headers: {
                        'Authorization': \`Bearer \${authToken}\`
                    }
                });

                const result = await response.json();
                if (result.success) {
                    const conversations = result.data;
                    const conversationList = document.getElementById('conversationList');
                    
                    if (conversations.length === 0) {
                        conversationList.innerHTML = '<p style="text-align: center; color: #718096;">暫無對話</p>';
                        return;
                    }

                    conversationList.innerHTML = conversations.map(conv => \`
                        <div class="conversation-item" onclick="selectConversation(\${conv.id}, '\${conv.customer_name}', '\${conv.platform}', '\${conv.platform_user_id}')">
                            <div class="customer-name">
                                \${conv.customer_name || '未知客戶'}
                                <span class="platform-badge platform-\${conv.platform}">\${conv.platform.toUpperCase()}</span>
                            </div>
                            <div style="font-size: 0.8rem; color: #718096; margin-top: 0.25rem;">
                                團隊: \${conv.team_name || '未指派'}
                                \${conv.assigned_user_name ? \` | 負責人: \${conv.assigned_user_name}\` : ''}
                            </div>
                            <span class="status-badge status-\${conv.status}">\${conv.status}</span>
                        </div>
                    \`).join('');
                }
            } catch (error) {
                console.error('載入對話失敗:', error);
            }
        }

        // 選擇對話
        function selectConversation(conversationId, customerName, platform, platformUserId) {
            currentConversation = { id: conversationId, customerName, platform, platformUserId };
            
            // 更新選中狀態
            document.querySelectorAll('.conversation-item').forEach(item => {
                item.classList.remove('active');
            });
            event.target.closest('.conversation-item').classList.add('active');

            // 更新訊息面板
            const messagePanel = document.getElementById('messagePanel');
            messagePanel.innerHTML = \`
                <div style="margin-bottom: 1rem;">
                    <strong>客戶:</strong> \${customerName}
                    <span class="platform-badge platform-\${platform}">\${platform.toUpperCase()}</span>
                </div>
                
                <div class="message-input">
                    <input type="text" id="messageContent" class="form-control" placeholder="輸入訊息..." onkeypress="if(event.key==='Enter') sendMessage()">
                    <button onclick="sendMessage()" class="btn">發送</button>
                </div>
                
                <div class="recall-controls">
                    <div class="recall-time">
                        <label>撤回時間:</label>
                        <input type="number" id="recallTime" value="15" min="0" max="120">
                        <span>秒</span>
                    </div>
                    <button onclick="sendMessageWithRecall()" class="btn btn-success">發送 (可撤回)</button>
                </div>
                
                <div style="margin-top: 1rem;">
                    <button onclick="assignConversation()" class="btn">指派對話</button>
                    <button onclick="transferConversation()" class="btn">轉移對話</button>
                </div>
            \`;
        }

        // 發送訊息
        async function sendMessage() {
            if (!currentConversation) return;
            
            const content = document.getElementById('messageContent').value;
            if (!content.trim()) return;

            try {
                const response = await fetch('/api/messages/send', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': \`Bearer \${authToken}\`
                    },
                    body: JSON.stringify({
                        conversationId: currentConversation.id,
                        content: content,
                        platform: currentConversation.platform,
                        recipientPlatformId: currentConversation.platformUserId,
                        recallTimeSeconds: 0
                    })
                });

                const result = await response.json();
                if (result.success) {
                    document.getElementById('messageContent').value = '';
                    alert('訊息發送成功！');
                } else {
                    alert('發送失敗: ' + result.error);
                }
            } catch (error) {
                alert('發送失敗: 網路錯誤');
            }
        }

        // 生成 QR Code
        async function generateQRCode() {
            const teamId = document.getElementById('qrTeamSelect').value;
            const campaignName = document.getElementById('campaignName').value;
            const maxUses = document.getElementById('maxUses').value;
            
            if (!teamId) {
                alert('請選擇團隊');
                return;
            }

            try {
                const response = await fetch(\`/api/teams/\${teamId}/qr-code\`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': \`Bearer \${authToken}\`
                    },
                    body: JSON.stringify({
                        campaignName: campaignName || undefined,
                        maxUses: maxUses ? parseInt(maxUses) : undefined
                    })
                });

                const result = await response.json();
                if (result.success) {
                    const qrDisplay = document.getElementById('qrCodeDisplay');
                    qrDisplay.innerHTML = \`
                        <img src="\${result.data.qrCodeImageUrl}" alt="QR Code">
                        <p style="margin-top: 0.5rem; font-size: 0.8rem;">
                            <strong>Line 連結:</strong><br>
                            <a href="\${result.data.lineUrl}" target="_blank">\${result.data.lineUrl}</a>
                        </p>
                        <p style="margin-top: 0.5rem; font-size: 0.8rem; color: #718096;">
                            Token: \${result.data.token}
                        </p>
                    \`;
                    qrDisplay.style.display = 'block';
                } else {
                    alert('生成失敗: ' + result.error);
                }
            } catch (error) {
                alert('生成失敗: 網路錯誤');
            }
        }

        // 創建團隊
        async function createTeam() {
            const name = document.getElementById('teamName').value;
            const description = document.getElementById('teamDescription').value;
            
            if (!name.trim()) {
                alert('請輸入團隊名稱');
                return;
            }

            try {
                const response = await fetch('/api/teams', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': \`Bearer \${authToken}\`
                    },
                    body: JSON.stringify({
                        name: name,
                        description: description
                    })
                });

                const result = await response.json();
                if (result.success) {
                    document.getElementById('teamName').value = '';
                    document.getElementById('teamDescription').value = '';
                    alert('團隊創建成功！');
                    await loadTeams();
                } else {
                    alert('創建失敗: ' + result.error);
                }
            } catch (error) {
                alert('創建失敗: 網路錯誤');
            }
        }

        // 顯示錯誤訊息
        function showError(elementId, message) {
            const errorElement = document.getElementById(elementId);
            errorElement.textContent = message;
            errorElement.style.display = 'block';
            setTimeout(() => {
                errorElement.style.display = 'none';
            }, 5000);
        }
    </script>
</body>
</html>`;

  return c.html(html);
});

// QR Code 加入團隊頁面
app.get('/join', async (c) => {
  try {
    const teamQRCode = c.req.query('team');
    
    if (!teamQRCode) {
      return c.html(`
        <html>
          <head><title>加入團隊</title></head>
          <body>
            <h1>無效的邀請連結</h1>
            <p>請檢查您的邀請連結是否正確。</p>
          </body>
        </html>
      `);
    }

    const team = await getTeamByQRCode(c.env.DB, teamQRCode);
    
    if (!team) {
      return c.html(`
        <html>
          <head><title>加入團隊</title></head>
          <body>
            <h1>邀請連結已過期</h1>
            <p>此邀請連結無效或已過期，請聯繫團隊管理員獲取新的邀請連結。</p>
          </body>
        </html>
      `);
    }

    return c.html(`
      <html>
        <head>
          <title>加入 ${team.name}</title>
          <meta charset="utf-8">
          <meta name="viewport" content="width=device-width, initial-scale=1">
          <style>
            body { font-family: Arial, sans-serif; max-width: 600px; margin: 50px auto; padding: 20px; }
            .team-info { background: #f5f5f5; padding: 20px; border-radius: 8px; margin: 20px 0; }
            .btn { background: #007bff; color: white; padding: 12px 24px; border: none; border-radius: 4px; cursor: pointer; text-decoration: none; display: inline-block; }
            .btn:hover { background: #0056b3; }
          </style>
        </head>
        <body>
          <h1>加入團隊邀請</h1>
          <div class="team-info">
            <h2>${team.name}</h2>
            ${team.description ? `<p>${team.description}</p>` : ''}
            <p><strong>團隊 ID:</strong> ${team.id}</p>
          </div>
          <p>您被邀請加入此團隊。請聯繫系統管理員完成帳戶設置。</p>
          <a href="/" class="btn">返回首頁</a>
        </body>
      </html>
    `);

  } catch (error) {
    console.error('Join team page error:', error);
    return c.html(`
      <html>
        <head><title>錯誤</title></head>
        <body>
          <h1>發生錯誤</h1>
          <p>處理邀請連結時發生錯誤，請稍後再試。</p>
        </body>
      </html>
    `);
  }
});

// ==================== 多平台 Webhook 處理 ====================

// LINE Webhook
app.post('/api/webhooks/line', async (c) => {
  try {
    const rawBody = await c.req.text();
    const body: LineWebhookBody = JSON.parse(rawBody);
    
    console.log(`Received LINE webhook: ${JSON.stringify(body, null, 2)}`);

    const { events } = body;

    // LINE Signature 驗證
    const signature = c.req.header('x-line-signature');
    const lineAdapter = new LineAdapter(c.env.LINE_CHANNEL_SECRET, c.env.LINE_CHANNEL_ACCESS_TOKEN);
    const isValidSignature = lineAdapter.verifyWebhook(signature || '', rawBody);
    
    if (!isValidSignature) {
      console.warn('Invalid LINE signature');
      return c.json({ error: 'Unauthorized' }, 401);
    }

    if (!events || events.length === 0) {
      return c.json({ message: 'No events received' }, 200);
    }

    // 處理事件
    const tasks = events.map((event: LineEvent) => {
      switch (event.type) {
        case 'message':
          if (event.message?.type === 'text') {
            return handleUnifiedMessageEvent(c, lineAdapter.normalizeMessage(event), event);
          }
          break;
        case 'follow':
          return handleFollowEvent(c, event);
        case 'unfollow':
          return handleUnfollowEvent(c, event);
        default:
          console.log(`Unhandled event type: ${event.type}`);
      }
      return Promise.resolve();
    });

    c.executionCtx.waitUntil(Promise.all(tasks));
    return c.json({ message: 'OK' }, 200);

  } catch (error) {
    console.error('Error processing LINE webhook:', error);
    return c.json({ error: 'Internal Server Error' }, 500);
  }
});

// Facebook Messenger Webhook
app.post('/api/webhooks/facebook', async (c) => {
  try {
    const body = await c.req.json();
    console.log(`Received Facebook webhook: ${JSON.stringify(body, null, 2)}`);

    // Facebook Webhook 驗證
    const signature = c.req.header('x-hub-signature-256');
    const facebookAdapter = new FacebookAdapter(c.env.FB_APP_SECRET, c.env.FB_PAGE_ACCESS_TOKEN);
    const isValidSignature = facebookAdapter.verifyWebhook(signature || '', JSON.stringify(body));
    
    if (!isValidSignature) {
      console.warn('Invalid Facebook signature');
      return c.json({ error: 'Unauthorized' }, 401);
    }

    // 處理 Facebook 訊息
    if (body.object === 'page') {
      const tasks = body.entry.map((entry: any) => {
        return entry.messaging?.map((messagingEvent: any) => {
          if (messagingEvent.message) {
            const unifiedMessage = facebookAdapter.normalizeMessage(messagingEvent);
            return handleUnifiedMessageEvent(c, unifiedMessage, messagingEvent);
          }
          return Promise.resolve();
        }) || [];
      }).flat();

      c.executionCtx.waitUntil(Promise.all(tasks));
    }

    return c.json({ message: 'OK' }, 200);

  } catch (error) {
    console.error('Error processing Facebook webhook:', error);
    return c.json({ error: 'Internal Server Error' }, 500);
  }
});

// Facebook Webhook 驗證 (GET 請求)
app.get('/api/webhooks/facebook', async (c) => {
  const mode = c.req.query('hub.mode');
  const token = c.req.query('hub.verify_token');
  const challenge = c.req.query('hub.challenge');

  if (mode === 'subscribe' && token === c.env.FB_VERIFY_TOKEN) {
    console.log('Facebook webhook verified');
    return c.text(challenge || '');
  }

  return c.json({ error: 'Forbidden' }, 403);
});

// 舊版 LINE Webhook (向後兼容)
app.post('/api/webhook', async (c) => {
  // 重定向到新的 LINE webhook 端點
  return app.fetch(new Request(c.req.url.replace('/api/webhook', '/api/webhooks/line'), {
    method: 'POST',
    headers: c.req.raw.headers,
    body: c.req.raw.body
  }));
});

/**
 * 處理統一格式的訊息事件 (支援多平台)
 */
async function handleUnifiedMessageEvent(
  c: { env: Bindings }, 
  unifiedMessage: any,
  originalEvent: any
): Promise<void> {
  const platformUserId = unifiedMessage.userId;
  const messageText = unifiedMessage.content;
  const messageId = unifiedMessage.messageId;
  const platform = unifiedMessage.platform;

  if (!messageText || !messageId) {
    console.error('Missing required message data');
    return;
  }

  try {
    console.log(`📱 處理來自用戶 ${platformUserId} 的訊息: "${messageText}"`);

    // 1. 獲取用戶詳細資訊 (根據平台)
    let userProfile: any = null;
    if (platform === 'line') {
      const { getLineUserProfile } = await import('./utils/line');
      userProfile = await getLineUserProfile(c.env.LINE_CHANNEL_ACCESS_TOKEN, platformUserId);
    }
    
    // 2. 尋找或建立客戶（包含詳細資訊）
    const customer = await findOrCreateCustomer(c.env.DB, platform, platformUserId, {
      displayName: userProfile?.displayName,
      avatarUrl: userProfile?.pictureUrl,
      metadata: {
        // statusMessage: userProfile?.statusMessage,
        lastActiveAt: new Date().toISOString(),
        notes: `Profile updated: ${userProfile?.statusMessage || 'No status'}`
      }
    });
    console.log(`👤 客戶處理完成 - ID: ${customer.id}, 姓名: ${customer.display_name || '未知'}, 平台: ${customer.platform}`);
    
    // 2. 尋找或建立對話
    const conversation = await findOrCreateConversation(c.env.DB, customer.id);
    console.log(`💬 對話處理完成 - ID: ${conversation.id}, 狀態: ${conversation.status}`);
    
    // 3. 智能會話管理 - 獲取或創建會話
    const { getOrCreateSession, getNextSessionSequence } = await import('./utils/session');
    const session = await getOrCreateSession(c.env.DB, conversation.id, messageText, 'customer');
    console.log(`🎯 會話管理 - ID: ${session.id}, 主題: ${session.topic || '未知'}, 當前訊息數: ${session.message_count}`);
    
    // 4. 獲取正確的會話順序編號
    const inboundSequence = await getNextSessionSequence(c.env.DB, session.id);
    
    // 5. 生成線程ID（用於關聯這組對話）
    const threadId = `thread_${conversation.id}_${Date.now()}`;
    
    // 6. 儲存傳入的訊息到 D1 資料庫（包含會話資訊）
    const inboundMessage = await saveMessage(c.env.DB, {
      id: messageId,
      conversationId: conversation.id,
      senderType: 'customer',
      senderId: customer.id,
      content: messageText,
      messageType: 'text',
      platformMessageId: messageId,
      direction: 'inbound',
      threadId: threadId,
      sessionId: session.id, // 🎯 會話ID
      sessionSequence: inboundSequence, // 🎯 正確的會話順序
      metadata: {
        platformUserId: platformUserId,
        platform: platform,
        originalEvent: originalEvent,
        sessionTopic: session.topic
      }
    });
    console.log(`💾 傳入訊息已儲存 - ID: ${inboundMessage.id}, 會話: ${session.id}, 順序: ${inboundSequence}`);

    // 7. 生成回覆訊息
    const replyText = generateReplyText(messageText);
    const replyMessage = createTextMessage(replyText);
    console.log(`🤖 生成回覆訊息: "${replyText}"`);

    // 8. 發送回覆到對應平台
    let success = false;
    if (platform === 'line' && originalEvent.replyToken) {
      success = await sendLineReply(
        c.env.LINE_CHANNEL_ACCESS_TOKEN,
        originalEvent.replyToken,
        [replyMessage]
      );
    } else if (platform === 'facebook') {
      // Facebook 發送邏輯
      success = true; // 暫時設為 true
    }

    if (success) {
      // 9. 獲取回覆訊息的正確順序編號
      const outboundSequence = await getNextSessionSequence(c.env.DB, session.id);
      
      // 10. 儲存發送的回覆訊息到 D1 資料庫（關聯到原始訊息和會話）
      const replyId = `reply_${Date.now()}_${Math.random().toString(36).substring(2, 11)}`;
      const outboundMessage = await saveMessage(c.env.DB, {
        id: replyId,
        conversationId: conversation.id,
        senderType: 'agent',
        content: replyText,
        messageType: 'text',
        direction: 'outbound',
        replyToMessageId: messageId, // 🔗 關聯到原始訊息
        threadId: threadId, // 🔗 同一個線程
        sessionId: session.id, // 🎯 同一個會話
        sessionSequence: outboundSequence, // 🎯 正確的會話順序
        metadata: {
          originalMessageId: messageId,
          originalContent: messageText,
          replyMethod: 'line_reply_api',
          generatedAt: new Date().toISOString(),
          sessionTopic: session.topic
        }
      });
      console.log(`💾 回覆訊息已儲存 - ID: ${outboundMessage.id}`);
      console.log(`🔗 訊息關聯: ${messageId} ← ${replyId}`);
      console.log(`🎯 會話關聯: 會話 ${session.id}, 順序 ${inboundSequence} → ${outboundSequence}`);
      console.log(`✅ 完整流程完成: 手機 → LINE → Worker → D1 → Worker → LINE → 手機`);
    } else {
      console.error('❌ 發送回覆失敗，未儲存回覆訊息');
    }

  } catch (error) {
    console.error('❌ 處理文字訊息時發生錯誤:', error);
  }
}

/**
 * 處理用戶關注事件 (支援 QR Code 自動指派)
 */
async function handleFollowEvent(
  c: { env: Bindings }, 
  event: LineEvent
): Promise<void> {
  const lineUserId = event.source.userId;

  try {
    // 處理 QR Code 自動指派
    const qrResult = await QRCodeService.handleQRCodeFollow(event as any);
    
    let welcomeMessage = '歡迎加入！我是您的專屬客服助手，有任何問題都可以問我喔！';
    
    if (qrResult.autoAssigned && qrResult.teamId) {
      // 獲取團隊資訊
      const team = await getTeamById(c.env.DB, qrResult.teamId);
      welcomeMessage = `歡迎加入 ${team?.name || '我們的團隊'}！我是您的專屬客服助手，有任何問題都可以問我喔！`;
      
      console.log(`User ${lineUserId} auto-assigned to team ${qrResult.teamId} via QR code`);
    }
    
    // 建立或更新客戶資料
    await findOrCreateCustomer(c.env.DB, 'line', lineUserId);
    
    if (event.replyToken) {
      const message = createTextMessage(welcomeMessage);
      await sendLineReply(
        c.env.LINE_CHANNEL_ACCESS_TOKEN,
        event.replyToken,
        [message]
      );
    }

    console.log(`User ${lineUserId} followed the bot`);
  } catch (error) {
    console.error('Error handling follow event:', error);
  }
}

/**
 * 處理用戶取消關注事件
 */
async function handleUnfollowEvent(
  _c: { env: Bindings }, 
  event: LineEvent
): Promise<void> {
  const lineUserId = event.source.userId;
  console.log(`User ${lineUserId} unfollowed the bot`);
  
  // 可以在這裡記錄取消關注的事件，但不需要回覆訊息
}

/**
 * 生成回覆文字
 */
function generateReplyText(inputText: string): string {
  // 簡單的鸚鵡回覆邏輯，未來可以擴展為更智能的回覆
  const responses = [
    `您說了：「${inputText}」`,
    `我收到您的訊息：${inputText}`,
    `謝謝您的訊息：${inputText}，我會盡快為您處理！`
  ];
  
  return responses[Math.floor(Math.random() * responses.length)] || responses[0] || '謝謝您的訊息！';
}

// 全域錯誤處理
app.onError((err, c) => {
  console.error('Global error handler:', err);
  return c.json({
    error: 'Internal Server Error',
    message: err.message,
    timestamp: new Date().toISOString()
  }, 500);
});

// 404 處理
app.notFound((c) => {
  return c.json({
    error: 'Not Found',
    message: 'The requested endpoint was not found',
    timestamp: new Date().toISOString()
  }, 404);
});

