{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://multi-channel-platform-frontend.pages.dev",
          "https://multi-channel.imfinethankyouandyou.com",
          "https://s3.imfinethankyouandyou.com",
          "http://localhost:3000",
          "http://localhost:3001",
          "http://127.0.0.1:3000"
        ],
        "methods": ["GET", "PUT", "HEAD", "DELETE"],
        "headers": ["content-type", "content-length", "x-amz-content-sha256", "x-amz-date", "authorization", "cache-control", "x-requested-with"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Type"],
      "maxAgeSeconds": 3600
    }
  ]
}
