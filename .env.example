# 環境變數配置範例
# 複製此檔案為 .env 並填入實際值
# ⚠️ 重要：.env 檔案包含敏感資訊，請勿提交到版本控制

# ========================================
# Terraform 部署所需環境變數 (user-deploy.ps1)
# ========================================

# Cloudflare 認證 (必要)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# LINE Bot 配置 (必要)
TF_VAR_line_channel_access_token=your_line_channel_access_token
TF_VAR_line_channel_secret=your_line_channel_secret

# 管理員帳戶設定 (必要)
TF_VAR_admin_email=admin@yourdomain.com
TF_VAR_admin_password=your_secure_admin_password_8chars_min

# Cloudflare 帳戶 ID (可選 - 腳本會自動偵測)
TF_VAR_cloudflare_account_id=your_cloudflare_account_id

# Facebook Messenger 配置 (可選)
TF_VAR_facebook_page_access_token=your_facebook_page_access_token
TF_VAR_facebook_app_secret=your_facebook_app_secret

# 自訂域名 (可選)
TF_VAR_custom_domain=api.yourdomain.com
TF_VAR_frontend_custom_domain=app.yourdomain.com

# ========================================
# 開發環境變數 (本地開發使用)
# ========================================

# JWT 密鑰 (本地開發)
JWT_SECRET=your-super-secret-jwt-key-here

# LINE Bot 配置 (本地開發)
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# Facebook Messenger 配置 (本地開發)
FACEBOOK_PAGE_ACCESS_TOKEN=your-facebook-page-access-token
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_VERIFY_TOKEN=your-facebook-verify-token

# Cloudflare 資源 ID (本地開發)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_DATABASE_ID=your-d1-database-id
CLOUDFLARE_D1_TOKEN=your-cloudflare-d1-token

# R2 存儲配置 (本地開發)
R2_PUBLIC_URL=https://s3-dev.imfinethankyouandyou.com
R2_ACCOUNT_ID=your-cloudflare-account-id

# 檔案上傳配置
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# 應用程式配置
ENVIRONMENT=development
NODE_ENV=development
APP_URL=http://localhost:8787
FRONTEND_URL=http://localhost:5173