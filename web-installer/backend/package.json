{
  "name": "crm-installer-backend",
  "version": "1.0.0",
  "description": "Self-hosted CRM Web Installer - Backend",
  "main": "src/index.ts",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "engines": {
    "npm": "use bun instead - see CLAUDE.md",
    "yarn": "use bun instead - see CLAUDE.md",
    "pnpm": "use bun instead - see CLAUDE.md"
  },
  "scripts": {
    "preinstall": "npx only-allow bun",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:ci": "INCLUDE_DO_TESTS=true vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.12.32"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.21",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "~3.2.7",
    "typescript": "^5.9.3",
    "vitest": "~3.2.7",
    "wrangler": "4.67.0"
  },
  "overrides": {
    "vite": "^7.3.2"
  }
}
