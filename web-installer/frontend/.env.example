# Frontend Environment Variables
# Copy this file to .env for local development

# API Base URL
# Development: Empty string (uses Vite proxy)
# Production: Your deployed Worker URL
VITE_API_BASE_URL=

# Example for production:
# VITE_API_BASE_URL=https://crm-installer-backend.your-account.workers.dev

# OAuth Redirect URI
# Development: http://localhost:3000/oauth/callback
# Production: https://your-installer-frontend.pages.dev/oauth/callback
VITE_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

# Environment
VITE_ENVIRONMENT=development
