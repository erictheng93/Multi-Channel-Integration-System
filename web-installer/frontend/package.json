{
  "name": "crm-web-installer-frontend",
  "version": "1.0.0",
  "description": "Frontend for CRM Web Installer - Self-hosted deployment system",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "engines": {
    "npm": "use bun instead - see CLAUDE.md",
    "yarn": "use bun instead - see CLAUDE.md",
    "pnpm": "use bun instead - see CLAUDE.md"
  },
  "scripts": {
    "preinstall": "npx only-allow bun",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "deploy:pages": "bun run build && bunx wrangler pages deploy dist --project-name=crm-installer-frontend"
  },
  "dependencies": {
    "pinia": "^2.3.1",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "terser": "^5.49.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.8"
  },
  "overrides": {
    "vite": "^7.3.2"
  }
}
