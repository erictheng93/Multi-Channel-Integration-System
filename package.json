{
  "name": "multi-channel-platform",
  "type": "module",
  "scripts": {
    "prepare": "husky install",
    "dev": "wrangler dev --remote",
    "dev:remote": "wrangler dev --remote",
    "dev:bun": "bunx wrangler dev --remote",
    "build": "tsc --noEmit",
    "bun:install": "bun install",
    "bun:dev": "bun run dev",
    "bun:build": "bun run build",
    "bun:test": "bun test",
    "lint:check": "npx tsc --noEmit && cd frontend && npx vue-tsc --noEmit && npm run lint -- --max-warnings 0",
    "deploy": "wrangler deploy --minify",
    "health:check": "curl -s https://multi-channel.imfinethankyouandyou.com/api/system/health",
    "health:check:ws": "curl -s https://multi-channel.imfinethankyouandyou.com/api/websocket/health",
    "health:check:all": "curl -f https://multi-channel.imfinethankyouandyou.com/api/system/health && curl -f https://multi-channel.imfinethankyouandyou.com/api/websocket/health",
    "health:check:detail": "curl -s https://multi-channel.imfinethankyouandyou.com/api/websocket/health-detail",
    "monitor:deployment": "node -e \"setInterval(async()=>{const r=await fetch('https://multi-channel.imfinethankyouandyou.com/api/websocket/health');console.log(new Date().toISOString(),await r.json())},30000)\"",
    "perf:baseline": "curl -s https://multi-channel.imfinethankyouandyou.com/api/websocket/metrics",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:seed": "wrangler d1 execute multi-channel-platform --remote --file=./seed.sql",
    "db:migrate:attachments": "npx tsx database/migrate-file-attachments.ts",
    "db:migrate:attachments:verify": "npx tsx database/migrate-file-attachments.ts --verify",
    "setup:r2": "npx tsx scripts/setup-r2-storage.ts",
    "setup:r2:prod": "npx tsx scripts/setup-r2-storage.ts --prod",
    "setup:production": "npm run setup:r2:prod && npm run db:migrate:attachments",
    "test:upload": "npx tsx tests/file-upload-end-to-end.test.ts",
    "verify:upload": "npx tsx scripts/verify-file-upload.ts",
    "status:upload": "npx tsx scripts/file-upload-status-check.ts",
    "deploy:upload": "npx tsx scripts/deploy-file-upload.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:introspect": "drizzle-kit introspect",
    "test:handlers": "npx tsx tests/run-handler-tests.ts",
    "test:handlers:main": "npx vitest tests/unit/handlers/*-main.test.ts",
    "test:handlers:delayed": "npx vitest tests/unit/handlers/delayed-message-main.test.ts",
    "test:handlers:auth": "npx vitest tests/unit/handlers/auth-main.test.ts",
    "test:handlers:team": "npx vitest tests/unit/handlers/team-main.test.ts",
    "test:handlers:system": "npx vitest tests/unit/handlers/system-main.test.ts",
    "sync:db": "npx tsx scripts/sync-database.ts",
    "sync:db:to-local": "npx tsx scripts/sync-database.ts --production-to-local",
    "sync:db:to-prod": "npx tsx scripts/sync-database.ts --local-to-production",
    "sync:db:schema": "npx tsx scripts/sync-database.ts --schema-only",
    "sync:db:data": "npx tsx scripts/sync-database.ts --data-only",
    "sync:db:full": "npx tsx scripts/sync-database.ts --full",
    "sync:db:live": "npx tsx scripts/sync-database.ts --production-to-local --no-dry-run",
    "sync:scheduler": "npx tsx scripts/sync-scheduler.ts",
    "sync:scheduler:start": "npx tsx scripts/sync-scheduler.ts start",
    "sync:scheduler:status": "npx tsx scripts/sync-scheduler.ts status",
    "sync:scheduler:test": "npx tsx scripts/sync-scheduler.ts test-sync",
    "test:handlers:conversation": "npx vitest tests/unit/handlers/conversation-main.test.ts",
    "test:handlers:customer": "npx vitest tests/unit/handlers/customer-main.test.ts",
    "db:view": "npx tsx scripts/db-viewer.ts",
    "db:query": "wrangler d1 execute multi-channel-platform --remote",
    "db:test-config": "npx tsx scripts/test-drizzle-config.ts",
    "test:api": "cd tests && npx tsx run-api-tests.ts",
    "test:api:endpoints": "cd tests && npx tsx api-endpoints-test.ts",
    "test:api:integration": "cd tests && npx tsx api-integration-test.ts",
    "test:api:load": "cd tests && npx tsx api-load-test.ts",
    "test:api:verbose": "cd tests && npx tsx run-api-tests.ts --verbose",
    "test:api:quick": "cd tests && npx tsx run-api-tests.ts endpoints",
    "test:health": "cd tests && npx tsx quick-health-check.ts",
    "test:health:prod": "cd tests && npx tsx quick-health-check.ts https://multi-channel.imfinethankyouandyou.com",
    "hash": "npx tsx scripts/generate-hash.ts",
    "hash:batch": "npx tsx scripts/generate-hash.ts batch",
    "sync:db:structure": "tsx scripts/sync-database-structure.ts prod",
    "test:load:websocket": "npx tsx scripts/load-testing/websocket-load-test.ts",
    "test:load:durable-objects": "npx tsx scripts/load-testing/durable-objects-stress-test.ts",
    "test:stress:connections": "npx tsx scripts/stress-testing/connection-storm-test.ts",
    "test:stress:messages": "npx tsx scripts/stress-testing/message-flood-test.ts",
    "benchmark": "npx tsx tools/performance/benchmark-suite.ts",
    "benchmark:baseline": "npm run benchmark -- --suites latency,throughput --iterations 500 --output baseline-results.json",
    "benchmark:compare": "npm run benchmark -- --suites latency,throughput --iterations 500 --output comparison-results.json",
    "profile:memory": "npx tsx tools/performance/memory-profiler.ts",
    "profile:memory:gc": "node --expose-gc npx tsx tools/performance/memory-profiler.ts",
    "test:all": "npx tsx scripts/run-all-tests.ts",
    "test:all:parallel": "npm run test:all -- --parallel true --concurrency 3",
    "test:load": "npm run test:all -- --category load",
    "test:stress": "npm run test:all -- --category stress",
    "test:benchmark": "npm run test:all -- --category benchmark",
    "test:production-readiness": "npm run test:all -- --suites websocket-load-test,durable-objects-stress-test,benchmark-suite",
    "monitor:start": "npx tsx src/monitoring/performance-monitor.ts",
    "monitor:phase1.4": "npx tsx scripts/monitoring/queue-monitor-phase1-4.ts",
    "monitor:phase1.4:status": "tail -f QUEUE_MONITORING_PHASE1_4_*.md",
    "dashboard": "echo 'Dashboard available at http://localhost:8787/dashboard'",
    "analyze:performance": "npm run benchmark && npm run profile:memory",
    "setup:test-env": "mkdir -p test-results && mkdir -p memory-profiles && mkdir -p benchmark-results",
    "clean:test-results": "rm -rf test-results/* memory-profiles/* benchmark-results/*",
    "validate:config": "npx tsx scripts/validate-configuration.ts",
    "validate:routes": "npx tsx scripts/validate-route-order.ts",
    "validate:routes:ci": "npx tsx scripts/validate-route-order.ts || (echo 'Route validation failed!' && exit 1)",
    "validate:all": "npm run validate:config && npm run validate:routes",
    "check:routes": "npx tsx scripts/detect-route-conflicts.ts",
    "check:routes:watch": "nodemon --exec npx tsx scripts/detect-route-conflicts.ts --watch src/modules --watch src/handlers",
    "check:routes:ci": "npx tsx scripts/detect-route-conflicts.ts || (echo 'Route conflict detection failed! See report above.' && exit 1)",
    "precheck:all": "npm run check:routes && npm run validate:all",
    "build:worker-bundle": "npx tsx scripts/build-worker-bundle.ts",
    "build:worker-bundle:bun": "bun scripts/build-worker-bundle.ts",
    "build:frontend-bundle": "npx tsx scripts/build-frontend-bundle.ts",
    "build:frontend-bundle:bun": "bun scripts/build-frontend-bundle.ts",
    "build:installer-bundles": "npm run build:worker-bundle && npm run build:frontend-bundle",
    "build:installer-bundles:bun": "bun run build:worker-bundle:bun && bun run build:frontend-bundle:bun"
  },
  "overrides": {
    "esbuild": "^0.25.9",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.9"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@aws-sdk/s3-request-presigner": "^3.948.0",
    "@hono/zod-validator": "^0.7.4",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.10.3",
    "ipaddr.js": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "qrcode": "^1.5.4",
    "uuid": "^10.0.0",
    "vue-i18n": "^11.1.12",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251014.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "better-sqlite3": "^12.5.0",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.35.0",
    "ws": "^8.18.3"
  }
}
