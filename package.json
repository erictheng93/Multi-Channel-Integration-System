{
  "name": "mcis-worker",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "engines": {
    "npm": "use bun instead - see CLAUDE.md",
    "yarn": "use bun instead - see CLAUDE.md",
    "pnpm": "use bun instead - see CLAUDE.md"
  },
  "scripts": {
    "preinstall": "npx only-allow bun",
    "prepare": "husky",
    "dev": "wrangler dev --remote",
    "dev:remote": "wrangler dev --remote",
    "build": "tsc --noEmit",
    "lint:check": "bunx tsc --noEmit && cd frontend && bunx vue-tsc --noEmit && bun run lint -- --max-warnings 0",
    "check": "bun scripts/check.ts",
    "check:backend": "bun scripts/check.ts backend",
    "check:frontend": "bun scripts/check.ts frontend",
    "predeploy": "bun scripts/check-schema-drift.ts",
    "deploy": "wrangler deploy --minify",
    "health:check": "curl -s https://mcis-backend.daiwandist.com/api/system/health",
    "health:check:ws": "curl -s https://mcis-backend.daiwandist.com/api/websocket/health",
    "health:check:all": "curl -f https://mcis-backend.daiwandist.com/api/system/health && curl -f https://mcis-backend.daiwandist.com/api/websocket/health",
    "health:check:detail": "curl -s https://mcis-backend.daiwandist.com/api/websocket/health-detail",
    "monitor:deployment": "node -e \"setInterval(async()=>{const r=await fetch('https://mcis-backend.daiwandist.com/api/websocket/health');console.log(new Date().toISOString(),await r.json())},30000)\"",
    "perf:baseline": "curl -s https://mcis-backend.daiwandist.com/api/websocket/metrics",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:seed": "wrangler d1 execute mcis-db --remote --file=./seed.sql",
    "db:migrate:attachments": "bun database/migrate-file-attachments.ts",
    "db:migrate:attachments:verify": "bun database/migrate-file-attachments.ts --verify",
    "setup:r2": "bun scripts/setup-r2-storage.ts",
    "setup:r2:prod": "bun scripts/setup-r2-storage.ts --prod",
    "setup:production": "bun run setup:r2:prod && bun run db:migrate:attachments",
    "test:upload": "bun tests/file-upload-end-to-end.test.ts",
    "verify:upload": "bun scripts/verify-file-upload.ts",
    "status:upload": "bun scripts/file-upload-status-check.ts",
    "deploy:upload": "bun scripts/deploy-file-upload.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:introspect": "drizzle-kit introspect",
    "test:handlers": "bun tests/run-handler-tests.ts",
    "test:handlers:unit": "bunx vitest run tests/unit/handlers/*.test.ts",
    "test:unit": "bunx vitest run tests/unit/**/*.test.ts",
    "test:unit:ci": "bunx vitest run tests/unit/**/*.test.ts --reporter=verbose",
    "test:modules": "bunx vitest run tests/modules/**/*.test.ts",
    "test:modules:ci": "bunx vitest run tests/modules/**/*.test.ts --reporter=verbose",
    "sync:db": "bun scripts/sync-database.ts",
    "sync:db:to-local": "bun scripts/sync-database.ts --production-to-local",
    "sync:db:to-prod": "bun scripts/sync-database.ts --local-to-production",
    "sync:db:schema": "bun scripts/sync-database.ts --schema-only",
    "sync:db:data": "bun scripts/sync-database.ts --data-only",
    "sync:db:full": "bun scripts/sync-database.ts --full",
    "sync:db:live": "bun scripts/sync-database.ts --production-to-local --no-dry-run",
    "sync:scheduler": "bun scripts/sync-scheduler.ts",
    "sync:scheduler:start": "bun scripts/sync-scheduler.ts start",
    "sync:scheduler:status": "bun scripts/sync-scheduler.ts status",
    "sync:scheduler:test": "bun scripts/sync-scheduler.ts test-sync",
    "test:backend:ci": "bunx vitest run tests/unit tests/modules tests/edge-cases tests/contract tests/validation tests/integration tests/database tests/smoke tests/api-documentation-consistency.test.ts --reporter=verbose --passWithNoTests",
    "test:installer:backend:ci": "cd web-installer/backend && bun install --frozen-lockfile && bun run test:ci",
    "db:view": "bun scripts/db-viewer.ts",
    "db:query": "wrangler d1 execute mcis-db --remote",
    "db:test-config": "bun scripts/test-drizzle-config.ts",
    "test:api": "cd tests && bun run-api-tests.ts",
    "test:api:endpoints": "cd tests && bun api-endpoints-test.ts",
    "test:api:integration": "cd tests && bun api-integration-test.ts",
    "test:api:load": "cd tests && bun api-load-test.ts",
    "test:api:verbose": "cd tests && bun run-api-tests.ts --verbose",
    "test:api:quick": "cd tests && bun run-api-tests.ts endpoints",
    "test:health": "cd tests && bun quick-health-check.ts",
    "test:health:prod": "cd tests && bun quick-health-check.ts https://mcis-backend.daiwandist.com",
    "hash": "bun scripts/generate-hash.ts",
    "hash:batch": "bun scripts/generate-hash.ts batch",
    "sync:db:structure": "bun scripts/sync-database-structure.ts prod",
    "test:load:websocket": "bun scripts/load-testing/websocket-load-test.ts",
    "test:load:durable-objects": "bun scripts/load-testing/durable-objects-stress-test.ts",
    "test:stress:connections": "bun scripts/stress-testing/connection-storm-test.ts",
    "test:stress:messages": "bun scripts/stress-testing/message-flood-test.ts",
    "benchmark": "bun tools/performance/benchmark-suite.ts",
    "benchmark:baseline": "bun run benchmark -- --suites latency,throughput --iterations 500 --output baseline-results.json",
    "benchmark:compare": "bun run benchmark -- --suites latency,throughput --iterations 500 --output comparison-results.json",
    "profile:memory": "bun tools/performance/memory-profiler.ts",
    "profile:memory:gc": "bun --expose-gc tools/performance/memory-profiler.ts",
    "test:all": "bun scripts/run-all-tests.ts",
    "test:all:parallel": "bun run test:all -- --parallel true --concurrency 3",
    "test:load": "bun run test:all -- --category load",
    "test:stress": "bun run test:all -- --category stress",
    "test:benchmark": "bun run test:all -- --category benchmark",
    "test:production-readiness": "bun run test:all -- --suites websocket-load-test,durable-objects-stress-test,benchmark-suite",
    "monitor:start": "bun src/monitoring/performance-monitor.ts",
    "monitor:phase1.4": "bun scripts/monitoring/queue-monitor-phase1-4.ts",
    "monitor:phase1.4:status": "tail -f QUEUE_MONITORING_PHASE1_4_*.md",
    "dashboard": "echo 'Dashboard available at http://localhost:8787/dashboard'",
    "analyze:performance": "bun run benchmark && bun run profile:memory",
    "setup:test-env": "mkdir -p test-results && mkdir -p memory-profiles && mkdir -p benchmark-results",
    "clean:test-results": "rm -rf test-results/* memory-profiles/* benchmark-results/*",
    "validate:config": "bun scripts/validate-configuration.ts",
    "validate:routes": "bun scripts/validate-route-order.ts",
    "validate:routes:ci": "bun scripts/validate-route-order.ts || (echo 'Route validation failed!' && exit 1)",
    "validate:all": "bun run validate:config && bun run validate:routes",
    "check:routes": "bun scripts/detect-route-conflicts.ts",
    "check:routes:watch": "nodemon --exec bun scripts/detect-route-conflicts.ts --watch src/modules --watch src/handlers",
    "check:routes:ci": "bun scripts/detect-route-conflicts.ts || (echo 'Route conflict detection failed! See report above.' && exit 1)",
    "check:sql-raw": "bun scripts/check-sql-raw.ts",
    "check:sql-raw:ci": "bun scripts/check-sql-raw.ts || (echo 'Unsafe sql.raw usage detected! See report above.' && exit 1)",
    "check:type-debt": "bun scripts/check-type-debt.ts",
    "precheck:all": "bun run check:routes && bun run validate:all",
    "build:worker-bundle": "bun scripts/build-worker-bundle.ts",
    "build:frontend-bundle": "bun scripts/build-frontend-bundle.ts",
    "build:installer-bundles": "bun run build:worker-bundle && bun run build:frontend-bundle"
  },
  "overrides": {
    "esbuild": "^0.25.9",
    "vite": "^7.3.2",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.9"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1002.0",
    "@aws-sdk/s3-request-presigner": "^3.1002.0",
    "@hono/zod-validator": "^0.7.6",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.5",
    "ipaddr.js": "^2.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^3.3.2",
    "qrcode": "^1.5.4",
    "uuid": "^10.0.0",
    "vue-i18n": "^11.2.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260305.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.4",
    "better-sqlite3": "^12.6.2",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "4.74.0",
    "ws": "^8.19.0"
  }
}
