ALTER TABLE `conversations` ADD COLUMN `priority` TEXT DEFAULT 'normal';
ALTER TABLE `conversations` ADD COLUMN `first_response_at` TEXT;
ALTER TABLE `conversations` ADD COLUMN `closed_at` TEXT;
ALTER TABLE `conversations` ADD COLUMN `internal_notes` TEXT;

