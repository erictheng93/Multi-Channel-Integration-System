{
  // Type-check for the Bun/Node tooling outside the Worker bundle:
  // scripts/, database/. Run with `bun run type-check:scripts`.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.cache/tsc-scripts.tsbuildinfo",
    "lib": ["ES2022"],
    "types": ["bun"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "scripts/**/*",
    "database/**/*"
  ],
  // .gitignore ignores test-*.ts, so local-only copies exist only on some machines and CI never sees them;
  // checking them made pre-push fail on files that are not in the repo. Tracked exceptions go in "files",
  // which exclude does not override.
  "exclude": [
    "scripts/**/test-*.ts",
    "database/**/test-*.ts"
  ],
  "files": [
    "scripts/test-drizzle-config.ts"
  ]
}
