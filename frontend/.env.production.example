# ============================================================================
# Production environment template
# ============================================================================
# Copy these keys into CI / Cloudflare Pages environment variables.
# Do not commit a real .env.production file.

VITE_BACKEND_URL=https://your-worker.example.com
VITE_FRONTEND_URL=https://your-app.example.com
VITE_FRONTEND_PAGES_URL=https://your-project.pages.dev
VITE_WEBSOCKET_URL=wss://your-worker.example.com
VITE_STORAGE_PUBLIC_URL=https://your-public-storage.example.com

VITE_ENV=production
VITE_DEV_MODE=false

VITE_ENABLE_DEBUG_LOGS=false
VITE_DEBUG=false
VITE_WEBSOCKET_DEBUG=false
VITE_SEARCH_DEBUG=false

VITE_WEBSOCKET_ENABLED=true
VITE_WEBSOCKET_AUTO_RECONNECT=true
VITE_WEBSOCKET_RECONNECT_DELAY=3000
VITE_WEBSOCKET_MAX_RETRIES=10

VITE_ENABLE_SEARCH_CACHE=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_EXPERIMENTAL_FEATURES=false
VITE_ENABLE_ACTIVITY_RESTORE=true

VITE_LIFF_ID=your-liff-id
