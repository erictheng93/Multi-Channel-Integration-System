import { describe, it, expect, vi, beforeEach, afterEach, type MockedFunction } from 'vitest'
import { mount, type VueWrapper } from '@vue/test-utils'
import { nextTick, ref, type Ref } from 'vue'
import type { TestComponentInstance, DelayedMessageRequest, DelayedMessageResponse, MockProps, TestGlobalConfig } from '@/types/test-types'
import type { PendingMessage } from '@/types'
import DelayedMessageSender from './DelayedMessageSender.vue'

// Mock the composable
const mockSendDelayed: MockedFunction<(request: DelayedMessageRequest) => Promise<{ success: boolean; data?: DelayedMessageResponse; error?: string }>> = vi.fn()
const mockRecall: MockedFunction<(messageId: string) => Promise<{ success: boolean; error?: string }>> = vi.fn()
const mockGetPendingMessages: MockedFunction<() => Promise<void>> = vi.fn()
const mockPendingMessages: Ref<PendingMessage[]> = ref([])
const mockIsLoading: Ref<boolean> = ref(false)

vi.mock('../composables/useDelayedMessage', () => ({
  useDelayedMessage: () => ({
    sendDelayedMessage: mockSendDelayed,
    recallMessage: mockRecall,
    getPendingMessages: mockGetPendingMessages,
    pendingMessages: mockPendingMessages,
    isLoading: mockIsLoading
  })
}))

describe('DelayedMessageSender', () => {
  let wrapper: VueWrapper<TestComponentInstance>

  beforeEach(() => {
    vi.clearAllMocks()
    mockGetPendingMessages.mockResolvedValue({ success: true })
  })

  afterEach(() => {
    if (wrapper) {
      wrapper.unmount()
    }
  })

  const createWrapper = (props: MockProps = {}): VueWrapper<TestComponentInstance> => {
    return mount(DelayedMessageSender, {
      props: {
        conversationId: 1,
        ...props
      },
      global: {} as TestGlobalConfig
    })
  }

  describe('Component Rendering', () => {
    it('should render message input area', () => {
      wrapper = createWrapper()
      
      expect(wrapper.find('.message-input').exists()).toBe(true)
      expect(wrapper.find('.btn-primary').text()).toBe('立即發送')
      expect(wrapper.find('.btn-secondary').text()).toBe('延遲發送')
    })

    it('should show delay options when delay button is clicked', async () => {
      wrapper = createWrapper()
      
      expect(wrapper.find('.delay-options').exists()).toBe(false)
      
      await wrapper.find('.btn-secondary').trigger('click')
      
      expect(wrapper.find('.delay-options').exists()).toBe(true)
      expect(wrapper.find('.delay-label').text()).toBe('延遲時間：')
    })

    it('should render delay preset buttons', async () => {
      wrapper = createWrapper()
      
      await wrapper.find('.btn-secondary').trigger('click')
      
      const presetButtons = wrapper.findAll('.quick-delay-btn')
      expect(presetButtons).toHaveLength(6)
      expect(presetButtons[0].text()).toBe('5秒')
      expect(presetButtons[1].text()).toBe('10秒')
      expect(presetButtons[2].text()).toBe('15秒')
      expect(presetButtons[5].text()).toBe('120秒')
    })
  })

  describe('Message Input', () => {
    it('should update message content when typing', async () => {
      wrapper = createWrapper()
      
      const textarea = wrapper.find('.message-input')
      await textarea.setValue('Test message')
      
      expect(wrapper.vm.messageContent).toBe('Test message')
    })

    it('should disable send button when message is empty', () => {
      wrapper = createWrapper()
      
      const sendButton = wrapper.find('.btn-primary')
      expect(sendButton.attributes('disabled')).toBeDefined()
    })

    it('should enable send button when message has content', async () => {
      wrapper = createWrapper()
      
      await wrapper.find('.message-input').setValue('Test message')
      await nextTick()
      
      const sendButton = wrapper.find('.btn-primary')
      expect(sendButton.attributes('disabled')).toBeUndefined()
    })

    it('should add new line on Shift+Enter', async () => {
      wrapper = createWrapper()
      
      const textarea = wrapper.find('.message-input')
      await textarea.setValue('First line')
      
      // Simulate Shift+Enter
      await textarea.trigger('keydown.enter.shift.exact')
      
      expect(wrapper.vm.messageContent).toBe('First line\n')
    })
  })

  describe('Delay Settings', () => {
    it('should validate delay seconds input', async () => {
      wrapper = createWrapper()
      
      await wrapper.find('.btn-secondary').trigger('click')
      
      // First select custom option to show the input
      const delaySelect = wrapper.find('.delay-select')
      await delaySelect.setValue('custom')
      await wrapper.vm.$nextTick()
      
      const delayInput = wrapper.find('.custom-delay-input')
      
      // Test minimum value
      await delayInput.setValue('0')
      await delayInput.trigger('input')
      expect(wrapper.vm.customDelaySeconds).toBe(1)
      
      // Test maximum value
      await delayInput.setValue('150')
      await delayInput.trigger('input')
      expect(wrapper.vm.customDelaySeconds).toBe(120)
    })

    it('should update delay seconds when preset button is clicked', async () => {
      wrapper = createWrapper()
      
      await wrapper.find('.btn-secondary').trigger('click')
      
      const presetButton = wrapper.find('.quick-delay-btn')
      await presetButton.trigger('click')
      
      expect(wrapper.vm.delaySeconds).toBe(5)
    })

    it('should show active state on selected preset', async () => {
      wrapper = createWrapper()
      
      await wrapper.find('.btn-secondary').trigger('click')
      
      // Default is 15 seconds (at index 2)
      const presetButtons = wrapper.findAll('.quick-delay-btn')
      expect(presetButtons[2].classes()).toContain('active')
    })

    it('should format scheduled time correctly', async () => {
      wrapper = createWrapper()
      
      await wrapper.find('.btn-secondary').trigger('click')
      
      const scheduledTime = wrapper.vm.formatScheduledTime
      // The format includes AM/PM in Chinese locale, so we check for time pattern
      expect(scheduledTime).toMatch(/\d{2}:\d{2}:\d{2}/)
    })
  })

  describe('Message Sending', () => {
    it('should emit messageSent event on immediate send', async () => {
      wrapper = createWrapper()
      
      await wrapper.find('.message-input').setValue('Test message')
      await wrapper.find('.btn-primary').trigger('click')
      
      expect(wrapper.emitted('messageSent')).toBeTruthy()
      expect(wrapper.emitted('messageSent')[0][0]).toEqual({
        id: expect.any(String),
        content: 'Test message',
        delay: 0
      })
    })

    it('should call sendDelayedMessage on delayed send', async () => {
      mockSendDelayed.mockResolvedValue({ success: true, data: { messageId: 'test-id' } })
      wrapper = createWrapper()
      
      await wrapper.find('.message-input').setValue('Test delayed message')
      await wrapper.find('.btn-secondary').trigger('click')
      await wrapper.find('.btn-warning').trigger('click')
      
      expect(mockSendDelayed).toHaveBeenCalledWith({
        conversationId: 1,
        content: 'Test delayed message',
        delaySeconds: 15
      })
    })

    it('should clear message content after successful send', async () => {
      wrapper = createWrapper()
      
      await wrapper.find('.message-input').setValue('Test message')
      await wrapper.find('.btn-primary').trigger('click')
      
      expect(wrapper.vm.messageContent).toBe('')
    })

    it('should disable delayed send button when conditions not met', async () => {
      wrapper = createWrapper()
      
      await wrapper.find('.btn-secondary').trigger('click')
      
      const delayedSendButton = wrapper.find('.btn-warning')
      expect(delayedSendButton.attributes('disabled')).toBeDefined()
    })
  })

  describe('Pending Messages', () => {
    const mockPendingMessage = {
      id: 'msg-1',
      content: 'Pending message',
      scheduledSendTime: new Date(Date.now() + 30000).toISOString(),
      canRecall: true,
      status: 'pending'
    }

    it('should not show pending messages section when empty', () => {
      wrapper = createWrapper()
      
      expect(wrapper.find('.pending-messages').exists()).toBe(false)
    })

    it('should show pending messages when available', async () => {
      // Mock pending messages
      mockPendingMessages.value = [mockPendingMessage]
      wrapper = createWrapper()
      
      await nextTick()
      
      expect(wrapper.find('.pending-messages').exists()).toBe(true)
      expect(wrapper.find('.pending-title').text()).toContain('待發送訊息 (1)')
    })

    it('should show recall button for recallable messages', async () => {
      mockPendingMessages.value = [mockPendingMessage]
      wrapper = createWrapper()
      await nextTick()
      
      const recallButton = wrapper.find('.btn-danger')
      expect(recallButton.exists()).toBe(true)
      expect(recallButton.text()).toBe('撤回')
    })

    it('should call recallMessage when recall button is clicked', async () => {
      mockRecall.mockResolvedValue({ success: true })
      mockPendingMessages.value = [mockPendingMessage]
      wrapper = createWrapper()
      await nextTick()
      
      await wrapper.find('.btn-danger').trigger('click')
      
      expect(mockRecall).toHaveBeenCalledWith('msg-1')
    })

    it('should show status badge for non-recallable messages', async () => {
      const sentMessage = { ...mockPendingMessage, canRecall: false, status: 'sent' }
      mockPendingMessages.value = [sentMessage]
      wrapper = createWrapper()
      await nextTick()
      
      const statusBadge = wrapper.find('.status-badge')
      expect(statusBadge.exists()).toBe(true)
      expect(statusBadge.text()).toBe('已發送')
    })
  })

  describe('Countdown Display', () => {
    it('should calculate countdown correctly', () => {
      wrapper = createWrapper()
      
      const futureTime = Date.now() + 30000 // 30 seconds from now
      const message = { scheduledSendTime: new Date(futureTime).toISOString() }
      
      const countdown = wrapper.vm.getCountdown(message)
      expect(countdown).toMatch(/30秒後發送/)
    })

    it('should show "即將發送" when time is up', () => {
      wrapper = createWrapper()
      
      const pastTime = Date.now() - 1000 // 1 second ago
      const message = { scheduledSendTime: new Date(pastTime).toISOString() }
      
      const countdown = wrapper.vm.getCountdown(message)
      expect(countdown).toBe('即將發送')
    })

    it('should apply correct countdown class based on remaining time', () => {
      wrapper = createWrapper()
      
      // Test urgent (< 5 seconds)
      const urgentTime = Date.now() + 3000
      const urgentMessage = { scheduledSendTime: new Date(urgentTime).toISOString() }
      expect(wrapper.vm.getCountdownClass(urgentMessage)).toBe('urgent')
      
      // Test warning (< 15 seconds)
      const warningTime = Date.now() + 10000
      const warningMessage = { scheduledSendTime: new Date(warningTime).toISOString() }
      expect(wrapper.vm.getCountdownClass(warningMessage)).toBe('warning')
      
      // Test normal (> 15 seconds)
      const normalTime = Date.now() + 30000
      const normalMessage = { scheduledSendTime: new Date(normalTime).toISOString() }
      expect(wrapper.vm.getCountdownClass(normalMessage)).toBe('normal')
    })
  })

  describe('Lifecycle Management', () => {
    it('should load pending messages on mount', () => {
      wrapper = createWrapper()
      
      expect(mockGetPendingMessages).toHaveBeenCalledWith(1)
    })

    it('should start countdown timer on mount', () => {
      wrapper = createWrapper()
      
      // Timer should be started (we can't easily test setInterval directly)
      expect(wrapper.vm.countdownTimer).toBeDefined()
    })

    it('should reload pending messages when conversation changes', async () => {
      wrapper = createWrapper({ conversationId: 1 })
      
      mockGetPendingMessages.mockClear()
      
      await wrapper.setProps({ conversationId: 2 })
      
      expect(mockGetPendingMessages).toHaveBeenCalledWith(2)
    })
  })

  describe('Error Handling', () => {
    it('should handle send delayed message error', async () => {
      mockSendDelayed.mockResolvedValue({ success: false, error: 'Network error' })
      
      wrapper = createWrapper()
      
      await wrapper.find('.message-input').setValue('Test message')
      await wrapper.find('.btn-secondary').trigger('click')
      await wrapper.find('.btn-warning').trigger('click')
      
      // Wait for async operation to complete
      await nextTick()
      
      // The component should handle the error gracefully
      expect(mockSendDelayed).toHaveBeenCalled()
      // Message content should not be cleared on error
      expect(wrapper.vm.messageContent).toBe('Test message')
    })

    it('should handle recall message error', async () => {
      mockRecall.mockResolvedValue({ success: false, error: 'Recall failed' })
      
      mockPendingMessages.value = [{
        id: 'msg-1',
        canRecall: true,
        content: 'Test',
        scheduledSendTime: new Date().toISOString()
      }]
      wrapper = createWrapper()
      await nextTick()
      
      await wrapper.find('.btn-danger').trigger('click')
      
      // Wait for async operation to complete
      await nextTick()
      
      // The component should handle the error gracefully
      expect(mockRecall).toHaveBeenCalledWith('msg-1')
      // The recalling state should be cleared
      expect(wrapper.vm.recallingMessages.has('msg-1')).toBe(false)
    })
  })
})