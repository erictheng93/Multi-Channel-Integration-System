// 專案名稱：Multi-Channel Support MVP
// 檔案路徑：/frontend/src/components/conversation/MessageBubble.test.ts
// Created by: Component Test Developer

import { describe, it, expect, beforeEach } from 'vitest'
import { mount, type VueWrapper } from '@vue/test-utils'
import { createPinia, setActivePinia, type Pinia } from 'pinia'
import type { Message } from '@/types'
import type { TestComponentInstance, MockProps, TestGlobalConfig } from '@/types/test-types'
import MessageBubble from './MessageBubble.vue'

describe('MessageBubble Component', () => {
  let pinia: Pinia

  beforeEach(() => {
    pinia = createPinia()
    setActivePinia(pinia)
  })

  const createWrapper = (props: MockProps = {}): VueWrapper<TestComponentInstance> => {
    return mount(MessageBubble, {
      props: {
        message: {
          id: 'msg-1',
          conversationId: 'conv-1',
          content: 'Test message',
          messageType: 'text',
          platform: 'line',
          timestamp: Date.now(),
          createdAt: Date.now(),
          senderType: 'customer',
          senderId: 'customer-1',
          ...props.message
        } as Message,
        ...props
      },
      global: {
        plugins: [pinia]
      } as TestGlobalConfig
    })
  }

  describe('Basic Rendering', () => {
    it('should render message content', () => {
      const wrapper = createWrapper({
        message: {
          id: 'msg-1',
          content: 'Hello World',
          messageType: 'text',
          senderType: 'customer',
          platform: 'line',
          timestamp: Date.now(),
          senderId: 'customer-1',
          conversationId: 'conv-1',
          createdAt: Date.now()
        }
      })

      expect(wrapper.text()).toContain('Hello World')
    })

    it('should apply correct CSS classes for incoming messages', () => {
      const wrapper = createWrapper({
        message: {
          id: 'msg-1',
          content: 'Test message',
          messageType: 'text',
          senderType: 'customer',
          platform: 'line',
          timestamp: Date.now(),
          senderId: 'customer-1',
          conversationId: 'conv-1',
          createdAt: Date.now()
        }
      })

      expect(wrapper.classes()).toContain('message-bubble')
      expect(wrapper.classes()).toContain('message-incoming')
    })

    it('should apply correct CSS classes for outgoing messages', () => {
      const wrapper = createWrapper({
        message: {
          id: 'msg-1',
          content: 'Test message',
          messageType: 'text',
          senderType: 'agent',
          platform: 'line',
          timestamp: Date.now(),
          senderId: 'agent-1',
          conversationId: 'conv-1',
          createdAt: Date.now()
        }
      })

      expect(wrapper.classes()).toContain('message-bubble')
      expect(wrapper.classes()).toContain('message-outgoing')
    })
  })

  describe('Message Types', () => {
    it('should render text messages', () => {
      const wrapper = createWrapper({
        message: {
          id: 'msg-1',
          content: 'This is a text message',
          messageType: 'text',
          senderType: 'customer',
          platform: 'line',
          timestamp: Date.now(),
          senderId: 'customer-1',
          conversationId: 'conv-1',
          createdAt: Date.now()
        }
      })

      expect(wrapper.find('.message-content').text()).toContain('This is a text message')
    })

    it('should render image messages', () => {
      const wrapper = createWrapper({
        message: {
          id: 'msg-1',
          content: 'https://example.com/image.jpg',
          messageType: 'image',
          senderType: 'customer',
          platform: 'line',
          timestamp: Date.now(),
          senderId: 'customer-1',
          conversationId: 'conv-1',
          createdAt: Date.now()
        },
        attachmentUrl: 'https://example.com/image.jpg'
      })

      expect(wrapper.find('.message-media').exists()).toBe(true)
      expect(wrapper.find('img').exists()).toBe(true)
    })

    it('should render file messages', () => {
      const wrapper = createWrapper({
        message: {
          id: 'msg-1',
          content: 'document.pdf',
          messageType: 'file',
          senderType: 'customer',
          platform: 'line',
          timestamp: Date.now(),
          senderId: 'customer-1',
          conversationId: 'conv-1',
          createdAt: Date.now()
        },
        attachmentUrl: 'https://example.com/document.pdf',
        attachmentName: 'document.pdf'
      })

      expect(wrapper.find('.message-file-content').exists()).toBe(true)
      expect(wrapper.text()).toContain('document.pdf')
    })
  })

  describe('Platform Indicators', () => {
    it('should show LINE platform styling', () => {
      const wrapper = createWrapper({
        message: {
          id: 'msg-1',
          content: 'Test message',
          messageType: 'text',
          senderType: 'customer',
          platform: 'line',
          timestamp: Date.now(),
          senderId: 'customer-1',
          conversationId: 'conv-1',
          createdAt: Date.now()
        }
      })

      expect(wrapper.find('.message-bubble').exists()).toBe(true)
    })

    it('should show Facebook platform styling', () => {
      const wrapper = createWrapper({
        message: {
          id: 'msg-1',
          content: 'Test message',
          messageType: 'text',
          senderType: 'customer',
          platform: 'facebook',
          timestamp: Date.now(),
          senderId: 'customer-1',
          conversationId: 'conv-1',
          createdAt: Date.now()
        }
      })

      expect(wrapper.find('.message-bubble').exists()).toBe(true)
    })
  })

  describe('Message Status', () => {
    it('should show delivered status for outgoing messages', () => {
      const wrapper = createWrapper({
        message: {
          id: 'msg-1',
          content: 'Test message',
          messageType: 'text',
          senderType: 'agent',
          platform: 'line',
          timestamp: Date.now(),
          senderId: 'agent-1',
          conversationId: 'conv-1',
          createdAt: Date.now()
        },
        delivered: true
      })

      expect(wrapper.classes()).toContain('message-delivered')
    })

    it('should show failed status for outgoing messages', () => {
      const wrapper = createWrapper({
        message: {
          id: 'msg-1',
          content: 'Test message',
          messageType: 'text',
          senderType: 'agent',
          platform: 'line',
          timestamp: Date.now(),
          senderId: 'agent-1',
          conversationId: 'conv-1',
          createdAt: Date.now()
        },
        delivered: false
      })

      expect(wrapper.classes()).toContain('message-failed')
    })
  })

  describe('File Handling', () => {
    it('should format file sizes correctly', () => {
      const wrapper = createWrapper()
      const component = wrapper.vm as TestComponentInstance

      expect(component.formatFileSize?.(0)).toBe('0 B')
      expect(component.formatFileSize?.(1024)).toBe('1 KB')
      expect(component.formatFileSize?.(1024 * 1024)).toBe('1 MB')
      expect(component.formatFileSize?.(1536)).toBe('1.5 KB')
    })

    it('should get correct file extension', () => {
      const wrapper = createWrapper()
      const component = wrapper.vm as TestComponentInstance

      expect(component.getFileExtension?.('document.pdf')).toBe('PDF')
      expect(component.getFileExtension?.('image.jpg')).toBe('JPG')
      expect(component.getFileExtension?.('file.txt')).toBe('TXT')
      expect(component.getFileExtension?.('noextension')).toBe('')
    })

    it('should get correct file type class', () => {
      const wrapper = createWrapper()
      const component = wrapper.vm as TestComponentInstance

      expect(component.getFileTypeClass?.('document.pdf')).toContain('pdf')
      expect(component.getFileTypeClass?.('image.jpg')).toContain('image')
      expect(component.getFileTypeClass?.('file.txt')).toContain('text')
    })
  })

  describe('Interactive Features', () => {
    it('should emit download event when download button is clicked', async () => {
      const wrapper = createWrapper({
        message: {
          id: 'msg-1',
          content: 'document.pdf',
          messageType: 'file',
          senderType: 'customer',
          platform: 'line',
          timestamp: Date.now(),
          senderId: 'customer-1',
          conversationId: 'conv-1',
          createdAt: Date.now()
        },
        attachmentUrl: 'https://example.com/document.pdf',
        attachmentName: 'document.pdf'
      })

      const downloadBtn = wrapper.find('[title="下載"]')
      if (downloadBtn.exists()) {
        await downloadBtn.trigger('click')
        expect(wrapper.emitted('download')).toBeTruthy()
      }
    })

    it('should emit preview event when image is clicked', async () => {
      const wrapper = createWrapper({
        message: {
          id: 'msg-1',
          content: 'https://example.com/image.jpg',
          messageType: 'image',
          senderType: 'customer',
          platform: 'line',
          timestamp: Date.now(),
          senderId: 'customer-1',
          conversationId: 'conv-1',
          createdAt: Date.now()
        },
        attachmentUrl: 'https://example.com/image.jpg'
      })

      const imageContainer = wrapper.find('.image-container')
      if (imageContainer.exists()) {
        await imageContainer.trigger('click')
        expect(wrapper.emitted('preview')).toBeTruthy()
      }
    })
  })

  describe('Long Messages', () => {
    it('should handle long text messages', () => {
      const longMessage = 'A'.repeat(1000)
      const wrapper = createWrapper({
        message: {
          id: 'msg-1',
          content: longMessage,
          messageType: 'text',
          senderType: 'customer',
          platform: 'line',
          timestamp: Date.now(),
          senderId: 'customer-1',
          conversationId: 'conv-1',
          createdAt: Date.now()
        }
      })

      expect(wrapper.text()).toContain(longMessage)
    })

    it('should preserve line breaks in messages', () => {
      const multilineMessage = 'Line 1\nLine 2\nLine 3'
      const wrapper = createWrapper({
        message: {
          id: 'msg-1',
          content: multilineMessage,
          messageType: 'text',
          senderType: 'customer',
          platform: 'line',
          timestamp: Date.now(),
          senderId: 'customer-1',
          conversationId: 'conv-1',
          createdAt: Date.now()
        }
      })

      expect(wrapper.text()).toContain('Line 1')
      expect(wrapper.text()).toContain('Line 2')
      expect(wrapper.text()).toContain('Line 3')
    })
  })

  describe('Error Handling', () => {
    it('should handle missing attachment gracefully', () => {
      const wrapper = createWrapper({
        message: {
          id: 'msg-1',
          content: 'document.pdf',
          messageType: 'file',
          senderType: 'customer',
          platform: 'line',
          timestamp: Date.now(),
          senderId: 'customer-1',
          conversationId: 'conv-1',
          createdAt: Date.now()
        }
        // No attachmentUrl provided
      })

      expect(wrapper.find('.message-bubble').exists()).toBe(true)
    })

    it('should handle image load error', async () => {
      const wrapper = createWrapper({
        message: {
          id: 'msg-1',
          content: 'https://example.com/broken-image.jpg',
          messageType: 'image',
          senderType: 'customer',
          platform: 'line',
          timestamp: Date.now(),
          senderId: 'customer-1',
          conversationId: 'conv-1',
          createdAt: Date.now()
        },
        attachmentUrl: 'https://example.com/broken-image.jpg'
      })

      const img = wrapper.find('img')
      if (img.exists()) {
        await img.trigger('error')
        expect(wrapper.emitted('image-error')).toBeTruthy()
      }
    })
  })
})