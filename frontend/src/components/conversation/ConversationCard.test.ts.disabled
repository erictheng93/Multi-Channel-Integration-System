import { describe, it, expect, vi, beforeEach } from 'vitest'
import { mount } from '@vue/test-utils'
import type { Conversation, User, Agent, Message } from '@/types'
import ConversationCard from './ConversationCard.vue'

// Mock the UI components
vi.mock('@/components/ui/PlatformBadge.vue', () => ({
  default: {
    name: 'PlatformBadge',
    template: '<div class="platform-badge">{{ platform }}</div>',
    props: {
      platform: { type: String, default: '' },
      showIcon: { type: Boolean, default: false }
    }
  }
}))

vi.mock('@/components/ui/StatusBadge.vue', () => ({
  default: {
    name: 'StatusBadge',
    template: '<div class="status-badge">{{ status }}</div>',
    props: ['status']
  }
}))

vi.mock('@/components/icons', () => ({
  UserIcon: {
    name: 'UserIcon',
    template: '<svg class="user-icon"></svg>'
  }
}))

describe('ConversationCard', () => {
  let mockUser: User
  let mockAgent: Agent
  let mockMessage: Message
  let mockConversation: Conversation

  beforeEach(() => {
    mockUser = {
      id: 'user-1',
      name: 'John Doe',
      platform: 'line',
      platformUserId: 'line-user-123',
      createdAt: new Date('2024-01-01T00:00:00Z').getTime()
    }

    mockAgent = {
      id: 'agent-1',
      email: 'agent@example.com',
      name: 'Agent Smith',
      role: 'agent',
      isActive: true,
      createdAt: new Date('2024-01-01T00:00:00Z').getTime()
    }

    mockMessage = {
      id: 'msg-1',
      conversationId: 'conv-1',
      senderType: 'customer',
      senderId: 'user-1',
      content: 'Hello, I need help with my order',
      messageType: 'text',
      platform: 'line',
      timestamp: new Date('2024-01-01T12:00:00Z').getTime(),
      createdAt: new Date('2024-01-01T12:00:00Z').getTime()
    }

    mockConversation = {
      id: 'conv-1',
      userId: 'user-1',
      user: mockUser,
      customer: mockUser, // backward compatibility
      assignedTo: 'agent-1',
      assignedAgent: mockAgent,
      status: 'open',
      platform: 'line',
      lastMessageAt: new Date('2024-01-01T12:00:00Z').getTime(),
      lastMessage: mockMessage,
      unreadCount: 2,
      createdAt: new Date('2024-01-01T10:00:00Z').getTime(),
      updatedAt: new Date('2024-01-01T12:00:00Z').getTime()
    }
  })

  describe('Component Rendering', () => {
    it('renders conversation card with basic information', () => {
      const wrapper = mount(ConversationCard, {
        props: {
          conversation: mockConversation
        }
      })

      expect(wrapper.find('.conversation-card').exists()).toBe(true)
      expect(wrapper.find('.customer-name').text()).toBe('John Doe')
      expect(wrapper.find('.customer-id').text()).toBe('line-user-123')
    })

    it('shows unread badge when conversation has unread messages', () => {
      const wrapper = mount(ConversationCard, {
        props: {
          conversation: mockConversation
        }
      })

      const unreadBadge = wrapper.find('.unread-badge')
      expect(unreadBadge.exists()).toBe(true)
      expect(unreadBadge.text()).toBe('2')
      expect(wrapper.find('.conversation-card').classes()).toContain('unread')
    })

    it('does not show unread badge when no unread messages', () => {
      const conversationWithoutUnread = {
        ...mockConversation,
        unreadCount: 0
      }

      const wrapper = mount(ConversationCard, {
        props: {
          conversation: conversationWithoutUnread
        }
      })

      expect(wrapper.find('.unread-badge').exists()).toBe(false)
      expect(wrapper.find('.conversation-card').classes()).not.toContain('unread')
    })

    it('applies selected class when selected prop is true', () => {
      const wrapper = mount(ConversationCard, {
        props: {
          conversation: mockConversation,
          selected: true
        }
      })

      expect(wrapper.find('.conversation-card').classes()).toContain('selected')
    })
  })

  describe('Customer Information Display', () => {
    it('displays customer name from user property', () => {
      const wrapper = mount(ConversationCard, {
        props: {
          conversation: mockConversation
        }
      })

      expect(wrapper.find('.customer-name').text()).toBe('John Doe')
    })

    it('falls back to customer property for backward compatibility', () => {
      const conversationWithCustomer = {
        ...mockConversation,
        user: undefined,
        customer: mockUser
      }

      const wrapper = mount(ConversationCard, {
        props: {
          conversation: conversationWithCustomer
        }
      })

      expect(wrapper.find('.customer-name').text()).toBe('John Doe')
    })

    it('shows fallback text when no user name available', () => {
      const conversationWithoutName = {
        ...mockConversation,
        user: { ...mockUser, name: '' },
        customer: undefined
      }

      const wrapper = mount(ConversationCard, {
        props: {
          conversation: conversationWithoutName
        }
      })

      expect(wrapper.find('.customer-name').text()).toBe('未知用戶')
    })

    it('generates correct customer initials', () => {
      const wrapper = mount(ConversationCard, {
        props: {
          conversation: mockConversation
        }
      })

      expect(wrapper.find('.customer-avatar').text()).toBe('JD')
    })

    it('handles single name for initials', () => {
      const conversationWithSingleName = {
        ...mockConversation,
        customer: { ...mockUser, name: 'John' },
        user: { ...mockUser, name: 'John' }
      }

      const wrapper = mount(ConversationCard, {
        props: {
          conversation: conversationWithSingleName
        }
      })

      expect(wrapper.find('.customer-avatar').text()).toBe('J')
    })
  })

  describe('Message Display', () => {
    it('displays last message content', () => {
      const wrapper = mount(ConversationCard, {
        props: {
          conversation: mockConversation
        }
      })

      expect(wrapper.find('.message-content').text()).toBe('Hello, I need help with my order')
    })

    it('truncates long messages', () => {
      const longMessage = 'A'.repeat(60)
      const conversationWithLongMessage = {
        ...mockConversation,
        lastMessage: { ...mockMessage, content: longMessage }
      }

      const wrapper = mount(ConversationCard, {
        props: {
          conversation: conversationWithLongMessage
        }
      })

      const messageContent = wrapper.find('.message-content').text()
      expect(messageContent).toBe(`${'A'.repeat(50)}...`)
    })

    it('shows fallback when no last message', () => {
      const conversationWithoutMessage = {
        ...mockConversation,
        lastMessage: undefined
      }

      const wrapper = mount(ConversationCard, {
        props: {
          conversation: conversationWithoutMessage
        }
      })

      expect(wrapper.find('.message-content').text()).toBe('暫無訊息')
    })
  })

  describe('Time Formatting', () => {
    it('formats recent time in minutes', () => {
      const recentTime = Date.now() - 30 * 60 * 1000 // 30 minutes ago
      const conversationWithRecentTime = {
        ...mockConversation,
        updatedAt: recentTime
      }

      const wrapper = mount(ConversationCard, {
        props: {
          conversation: conversationWithRecentTime
        }
      })

      expect(wrapper.find('.message-time').text()).toBe('30分鐘前')
    })

    it('formats time in hours for same day', () => {
      const hoursAgo = Date.now() - 3 * 60 * 60 * 1000 // 3 hours ago
      const conversationWithHoursAgo = {
        ...mockConversation,
        updatedAt: hoursAgo
      }

      const wrapper = mount(ConversationCard, {
        props: {
          conversation: conversationWithHoursAgo
        }
      })

      expect(wrapper.find('.message-time').text()).toBe('3小時前')
    })

    it('formats date for older messages', () => {
      const oldDate = new Date('2024-01-01T12:00:00Z').getTime()
      const conversationWithOldDate = {
        ...mockConversation,
        updatedAt: oldDate
      }

      const wrapper = mount(ConversationCard, {
        props: {
          conversation: conversationWithOldDate
        }
      })

      const messageTime = wrapper.find('.message-time').text()
      expect(messageTime).toMatch(/1月1日|1月 1日|Jan 1/) // Depends on locale
    })
  })

  describe('Agent Assignment', () => {
    it('shows assigned agent when present', () => {
      const wrapper = mount(ConversationCard, {
        props: {
          conversation: mockConversation
        }
      })

      const assignedAgent = wrapper.find('.assigned-agent')
      expect(assignedAgent.exists()).toBe(true)
      expect(assignedAgent.text()).toContain('Agent Smith')
    })

    it('does not show assigned agent section when no agent assigned', () => {
      const conversationWithoutAgent = {
        ...mockConversation,
        assignedAgent: undefined
      }

      const wrapper = mount(ConversationCard, {
        props: {
          conversation: conversationWithoutAgent
        }
      })

      expect(wrapper.find('.assigned-agent').exists()).toBe(false)
    })
  })

  describe('Event Handling', () => {
    it('emits select event when clicked', async () => {
      const wrapper = mount(ConversationCard, {
        props: {
          conversation: mockConversation
        }
      })

      await wrapper.find('.conversation-card').trigger('click')

      expect(wrapper.emitted('select')).toBeTruthy()
      expect(wrapper.emitted('select')?.[0]).toEqual([mockConversation])
    })
  })

  describe('Platform Integration', () => {
    it('displays platform badge with correct platform', () => {
      const wrapper = mount(ConversationCard, {
        props: {
          conversation: mockConversation
        }
      })

      const platformBadge = wrapper.findComponent({ name: 'PlatformBadge' })
      expect(platformBadge.exists()).toBe(true)
      expect(platformBadge.props('platform')).toBe('line')
      expect(platformBadge.props('showIcon')).toBe(true)
    })

    it('falls back to user platform when conversation platform not available', () => {
      const conversationWithoutPlatform = {
        ...mockConversation,
        platform: undefined
      }

      const wrapper = mount(ConversationCard, {
        props: {
          conversation: conversationWithoutPlatform
        }
      })

      const platformBadge = wrapper.findComponent({ name: 'PlatformBadge' })
      expect(platformBadge.props('platform')).toBe('line')
    })

    it('uses default platform when neither conversation nor user platform available', () => {
      const conversationWithoutPlatforms = {
        ...mockConversation,
        platform: undefined,
        user: undefined,
        customer: undefined
      } as Conversation

      const wrapper = mount(ConversationCard, {
        props: {
          conversation: conversationWithoutPlatforms
        }
      })

      const platformBadge = wrapper.findComponent({ name: 'PlatformBadge' })
      if (platformBadge.exists()) {
        expect(platformBadge.props('platform')).toBe('line')
      }
    })
  })

  describe('Status Display', () => {
    it('displays status badge with correct status', () => {
      const wrapper = mount(ConversationCard, {
        props: {
          conversation: mockConversation
        }
      })

      const statusBadge = wrapper.findComponent({ name: 'StatusBadge' })
      expect(statusBadge.exists()).toBe(true)
      expect(statusBadge.props('status')).toBe('open')
    })
  })

  describe('Edge Cases', () => {
    it('handles missing customer data gracefully', () => {
      const conversationWithoutCustomer = {
        ...mockConversation,
        user: undefined,
        customer: undefined
      }

      const wrapper = mount(ConversationCard, {
        props: {
          conversation: conversationWithoutCustomer
        }
      })

      expect(wrapper.find('.customer-name').text()).toBe('未知用戶')
      expect(wrapper.find('.customer-id').text()).toBe('')
      expect(wrapper.find('.customer-avatar').text()).toBe('U')
    })

    it('handles Date objects for timestamps', () => {
      const conversationWithDateObjects = {
        ...mockConversation,
        createdAt: new Date('2024-01-01T10:00:00Z'),
        updatedAt: new Date('2024-01-01T12:00:00Z')
      }

      const wrapper = mount(ConversationCard, {
        props: {
          conversation: conversationWithDateObjects
        }
      })

      expect(wrapper.find('.conversation-card').exists()).toBe(true)
      expect(wrapper.find('.message-time').exists()).toBe(true)
    })

    it('handles zero unread count', () => {
      const conversationWithZeroUnread = {
        ...mockConversation,
        unreadCount: 0
      }

      const wrapper = mount(ConversationCard, {
        props: {
          conversation: conversationWithZeroUnread
        }
      })

      expect(wrapper.find('.unread-badge').exists()).toBe(false)
      expect(wrapper.find('.conversation-card').classes()).not.toContain('unread')
    })

    it('handles undefined unread count', () => {
      const conversationWithUndefinedUnread = {
        ...mockConversation,
        unreadCount: undefined
      } as Conversation

      const wrapper = mount(ConversationCard, {
        props: {
          conversation: conversationWithUndefinedUnread
        }
      })

      expect(wrapper.find('.unread-badge').exists()).toBe(false)
      expect(wrapper.find('.conversation-card').classes()).not.toContain('unread')
    })

    it('handles invalid dates gracefully', () => {
      const conversationWithInvalidDate = {
        ...mockConversation,
        updatedAt: NaN // Invalid timestamp
      }

      const wrapper = mount(ConversationCard, {
        props: {
          conversation: conversationWithInvalidDate
        }
      })

      expect(wrapper.find('.message-time').text()).toBe('時間未知')
    })

    it('handles future dates', () => {
      const futureDate = Date.now() + 60 * 60 * 1000 // 1 hour in future
      const conversationWithFutureDate = {
        ...mockConversation,
        updatedAt: futureDate
      }

      const wrapper = mount(ConversationCard, {
        props: {
          conversation: conversationWithFutureDate
        }
      })

      expect(wrapper.find('.message-time').text()).toBe('剛剛')
    })

    it('handles very recent messages (0 minutes)', () => {
      const veryRecentTime = Date.now() - 30 * 1000 // 30 seconds ago
      const conversationWithVeryRecentTime = {
        ...mockConversation,
        updatedAt: veryRecentTime
      }

      const wrapper = mount(ConversationCard, {
        props: {
          conversation: conversationWithVeryRecentTime
        }
      })

      expect(wrapper.find('.message-time').text()).toBe('剛剛')
    })
  })

  describe('Accessibility', () => {
    it('has proper semantic structure', () => {
      const wrapper = mount(ConversationCard, {
        props: {
          conversation: mockConversation
        }
      })

      expect(wrapper.find('h3.customer-name').exists()).toBe(true)
      expect(wrapper.find('time.message-time').exists()).toBe(true)
    })

    it('has proper ARIA attributes', () => {
      const wrapper = mount(ConversationCard, {
        props: {
          conversation: mockConversation,
          selected: true
        }
      })

      const card = wrapper.find('.conversation-card')
      expect(card.attributes('role')).toBe('button')
      expect(card.attributes('tabindex')).toBe('0')
      expect(card.attributes('aria-selected')).toBe('true')
      expect(card.attributes('aria-label')).toContain('與 John Doe 的對話')
    })

    it('handles keyboard navigation', async () => {
      const wrapper = mount(ConversationCard, {
        props: {
          conversation: mockConversation
        }
      })

      const card = wrapper.find('.conversation-card')

      // Test Enter key
      await card.trigger('keydown.enter')
      expect(wrapper.emitted('select')).toBeTruthy()

      // Test Space key
      await card.trigger('keydown.space')
      expect(wrapper.emitted('select')).toHaveLength(2)
    })

    it('generates proper aria-label with unread messages', () => {
      const wrapper = mount(ConversationCard, {
        props: {
          conversation: mockConversation
        }
      })

      const card = wrapper.find('.conversation-card')
      const ariaLabel = card.attributes('aria-label')
      expect(ariaLabel).toContain('與 John Doe 的對話')
      expect(ariaLabel).toContain('2 則未讀訊息')
      expect(ariaLabel).toContain('狀態：待處理')
    })

    it('generates proper aria-label without unread messages', () => {
      const conversationWithoutUnread = {
        ...mockConversation,
        unreadCount: 0
      }

      const wrapper = mount(ConversationCard, {
        props: {
          conversation: conversationWithoutUnread
        }
      })

      const card = wrapper.find('.conversation-card')
      const ariaLabel = card.attributes('aria-label')
      expect(ariaLabel).toContain('與 John Doe 的對話')
      expect(ariaLabel).not.toContain('未讀訊息')
      expect(ariaLabel).toContain('狀態：待處理')
    })
  })
})