# Multi-Channel Support MVP - Frontend Environment Variables
# Copy this file to .env.local and fill in the actual values

# Security Configuration
# Generate a secure 32+ character encryption key for local storage encryption
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VITE_ENCRYPTION_KEY=your-32-character-encryption-key-here

# API Configuration
# Backend API base URL
VITE_API_BASE_URL=http://localhost:8787

# Development Configuration
# Set to true for development mode features
VITE_DEV_MODE=true

# Feature Flags
# Enable/disable specific features
VITE_ENABLE_DEBUG_LOGS=true
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Third-party Integrations
# Add any third-party service configurations here
# VITE_ANALYTICS_ID=
# VITE_ERROR_REPORTING_DSN=