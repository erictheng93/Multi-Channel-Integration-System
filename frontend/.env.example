# ============================================================================
# 環境變量模板 - 請複製為 .env.local 並填入實際值
# ============================================================================
# 本文件是環境變量的完整參考模板
# 用於本地開發時，複製此文件為 .env.local 並根據需要修改

# ----------------------------------------------------------------------------
# 核心 URL 配置 (必須)
# ----------------------------------------------------------------------------
# 後端 API URL - 您的 Cloudflare Worker 域名
VITE_BACKEND_URL=https://your-worker-domain.workers.dev

# 前端 URL - 本地開發或生產域名
VITE_FRONTEND_URL=http://localhost:5173

# WebSocket URL - 通常與後端相同但使用 wss:// 協議
VITE_WEBSOCKET_URL=wss://your-worker-domain.workers.dev/ws

# R2 存儲公開 URL - 文件訪問域名
VITE_STORAGE_PUBLIC_URL=https://your-r2-public-domain.com

# ----------------------------------------------------------------------------
# 環境標識
# ----------------------------------------------------------------------------
# 環境類型: development | staging | production
VITE_ENV=development

# 開發模式開關
VITE_DEV_MODE=true

# ----------------------------------------------------------------------------
# 安全配置 (可選)
# ----------------------------------------------------------------------------
# 本地存儲加密密鑰 (32+ 字符)
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VITE_ENCRYPTION_KEY=your-32-character-encryption-key-here

# ----------------------------------------------------------------------------
# 調試與日誌配置 (可選)
# ----------------------------------------------------------------------------
# 啟用調試日誌
VITE_ENABLE_DEBUG_LOGS=true
VITE_DEBUG=true
VITE_WEBSOCKET_DEBUG=true
VITE_SEARCH_DEBUG=false

# ----------------------------------------------------------------------------
# WebSocket 配置 (可選)
# ----------------------------------------------------------------------------
# 啟用 WebSocket
VITE_WEBSOCKET_ENABLED=true

# 自動重連
VITE_WEBSOCKET_AUTO_RECONNECT=true

# 重連延遲 (毫秒)
VITE_WEBSOCKET_RECONNECT_DELAY=5000

# 最大重試次數
VITE_WEBSOCKET_MAX_RETRIES=5

# ----------------------------------------------------------------------------
# 功能開關 (可選)
# ----------------------------------------------------------------------------
# 搜索緩存
VITE_ENABLE_SEARCH_CACHE=true

# 性能監控
VITE_ENABLE_PERFORMANCE_MONITORING=true

# 實驗性功能
VITE_ENABLE_EXPERIMENTAL_FEATURES=false

# ----------------------------------------------------------------------------
# 第三方集成 (可選)
# ----------------------------------------------------------------------------
# LINE LIFF ID - 用於 QR Code 團隊綁定
VITE_LIFF_ID=your-liff-id-here

# 分析服務
# VITE_ANALYTICS_ID=your-analytics-id

# 錯誤報告
# VITE_ERROR_REPORTING_DSN=your-error-reporting-dsn
