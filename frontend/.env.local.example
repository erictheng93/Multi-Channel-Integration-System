# 本地開發環境變數 (複製為 .env.local 並修改)
# 這個文件不會被提交到版本控制

# API 配置 - 根據你的開發需求選擇
# 選項 1: 遠程 Worker (推薦)
VITE_API_BASE_URL=https://multi-channel.imfinethankyouandyou.com

# 選項 2: 本地 Worker 開發 (不推薦，此專案不使用本地後端)
# VITE_API_BASE_URL=http://localhost:8787

# 開發配置
VITE_DEV_MODE=true
VITE_ENABLE_DEBUG_LOGS=true
VITE_DEBUG=true

# 安全配置 (可選)
# VITE_ENCRYPTION_KEY=your-32-character-encryption-key-here