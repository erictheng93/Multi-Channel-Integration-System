# 本地開發環境變數 (複製為 .env.development.local 並修改)
# 這個文件不會被提交到版本控制
#
# 注意：不要複製成 .env.local。Vite 的優先順序是
#   .env.development.local > .env.development > .env.local > .env
# 而 .env.development 已設定 production 的 VITE_API_BASE_URL / VITE_BACKEND_URL，
# 會蓋掉 .env.local，導致前端仍然打到 production。
# 只想連本地 Worker 的話，直接用 `bun run dev:local` 即可，不需要這個檔案。

# API 配置 - 根據你的開發需求選擇
# 選項 1: 本地 Worker 開發 (推薦用於開發)
VITE_API_BASE_URL=http://localhost:8787
VITE_BACKEND_URL=http://localhost:8787
VITE_FRONTEND_URL=http://localhost:3000

# 選項 2: 遠程 Worker (用於連接生產環境 - 請替換為你的實際域名)
# VITE_API_BASE_URL=https://your-api-domain.example.com
# VITE_BACKEND_URL=https://your-api-domain.example.com
# VITE_FRONTEND_URL=https://your-frontend-domain.example.com

# 開發配置
VITE_DEV_MODE=true
VITE_ENABLE_DEBUG_LOGS=true
VITE_DEBUG=true

# 安全配置 (可選)
# VITE_ENCRYPTION_KEY=your-32-character-encryption-key-here