{
  "name": "multi-channel-platform-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development --host --port 3000",
    "dev:local": "vite --mode local --host --port 3000",
    "dev:remote": "vite --mode development --host --port 3000",
    "dev:prod": "vite --mode production --host --port 3000",
    "switch:local": "powershell -ExecutionPolicy Bypass -File scripts/switch-to-local.ps1",
    "switch:prod": "powershell -ExecutionPolicy Bypass -File scripts/switch-to-prod.ps1",
    "build": "vue-tsc && vite build",
    "build:pages": "npm run build && npm run copy-pages-config",
    "copy-pages-config": "node scripts/copy-pages-config.js",
    "deploy:pages": "node scripts/deploy-to-pages.js",
    "deploy:pages-quick": "node scripts/deploy-to-pages.js --skip-build",
    "verify:deployment": "powershell -ExecutionPolicy Bypass -File scripts/verify-deployment-simple.ps1 -Environment production",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "build:analyze": "ANALYZE=true npm run build",
    "build:report": "npx tsx scripts/build-analysis.ts",
    "build:perf": "vite build --config vite.config.performance.ts",
    "dev:debug": "vite --mode development --host --debug",
    "clean": "rm -rf dist node_modules/.vite",
    "prebuild:disabled": "npm run lint:check",
    "dev-tools:check": "npx tsx scripts/dev-tools-check.ts",
    "workflow": "npx tsx scripts/dev-workflow.ts",
    "health": "npx tsx scripts/health-check.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "^3.13.12",
    "@vueuse/core": "^13.9.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.0",
    "js-cookie": "^3.0.5",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.17.21",
    "lunr": "^2.3.9",
    "pinia": "^3.0.3",
    "vue": "^3.5.12",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/vue": "^8.1.0",
    "@types/dompurify": "^3.0.5",
    "@types/lodash-es": "^4.17.12",
    "@types/lunr": "^2.3.7",
    "@types/node": "^24.9.1",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.38.0",
    "eslint-plugin-vue": "^10.5.1",
    "happy-dom": "^20.0.8",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.5",
    "terser": "^5.44.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-bundle-analyzer": "^1.2.3",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.2"
  }
}
