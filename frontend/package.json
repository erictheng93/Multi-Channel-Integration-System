{
  "name": "multi-channel-platform-frontend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development --host --port 3000",
    "dev:local": "vite --mode local --host --port 3000",
    "dev:remote": "vite --mode development --host --port 3000",
    "dev:prod": "vite --mode production --host --port 3000",
    "switch:local": "powershell -ExecutionPolicy Bypass -File scripts/switch-to-local.ps1",
 
    "switch:prod": "powershell -ExecutionPolicy Bypass -File scripts/switch-to-prod.ps1",
    "build": "vue-tsc && vite build",
    "build:pages": "npm run build && npm run copy-pages-config",
    "copy-pages-config": "powershell -ExecutionPolicy Bypass -File scripts/copy-pages-config.ps1",
    "deploy:pages": "powershell -ExecutionPolicy Bypass -File scripts/deploy-to-pages.ps1",
    "deploy:pages-quick": "powershell -ExecutionPolicy Bypass -File scripts/deploy-to-pages.ps1 -SkipBuild",
    "verify:deployment": "powershell -ExecutionPolicy Bypass -File scripts/verify-deployment-simple.ps1 -Environment production",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "build:analyze": "ANALYZE=true npm run build",
    "build:report": "npx tsx scripts/build-analysis.ts",
    "build:perf": "vite build --config vite.config.performance.ts",
    "dev:debug": "vite --mode development --host --debug",
    "clean": "rm -rf dist node_modules/.vite",
    "prebuild:disabled": "npm run lint:check",
    "dev-tools:check": "npx tsx scripts/dev-tools-check.ts",
    "workflow": "npx tsx scripts/dev-workflow.ts",
    "health": "npx tsx scripts/health-check.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@vueuse/core": "^11.2.0",
    "date-fns": "^4.1.0",
    "js-cookie": "^3.0.5",
    "pinia": "^2.2.6",
    "vue": "^3.5.12",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.5.0"
  },
  "overrides": {
    "esbuild": "^0.25.9"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.17.0",
    "happy-dom": "^18.0.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.3",
    "terser": "^5.43.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.19",
    "vite-bundle-analyzer": "^0.7.0",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.0.0"
  }
}
