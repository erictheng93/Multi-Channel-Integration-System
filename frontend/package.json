{
  "name": "mcis-frontend",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "engines": {
    "npm": "use bun instead - see CLAUDE.md",
    "yarn": "use bun instead - see CLAUDE.md",
    "pnpm": "use bun instead - see CLAUDE.md"
  },
  "scripts": {
    "preinstall": "bunx only-allow bun",
    "dev": "vite --mode development --host --port 5173",
    "dev:local": "vite --mode local --host --port 5173",
    "dev:remote": "vite --mode development --host --port 5173",
    "dev:prod": "vite --mode production --host --port 5173",
    "switch:local": "node scripts/switch-environment.cjs local",
    "switch:prod": "node scripts/switch-environment.cjs prod",
    "switch:remote": "node scripts/switch-environment.cjs remote",
    "build": "vue-tsc && vite build",
    "build:pages": "bun run build && bun run copy-pages-config",
    "copy-pages-config": "node scripts/copy-pages-config.js",
    "deploy:pages": "bun scripts/deploy-to-pages.ts",
    "deploy:pages-quick": "bun scripts/deploy-to-pages.ts --skip-build",
    "verify:deployment": "node scripts/verify-deployment.cjs production",
    "verify:deployment:dev": "node scripts/verify-deployment.cjs development",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "lint:production": "bun scripts/lint-production.ts",
    "lint:scoped-btn": "bun scripts/check-scoped-btn.ts",
    "build:analyze": "ANALYZE=true bun run build",
    "build:report": "bunx tsx scripts/build-analysis.ts",
    "build:perf": "vite build --config vite.config.performance.ts",
    "dev:debug": "vite --mode development --host --debug",
    "clean": "rm -rf dist node_modules/.vite",
    "prebuild:disabled": "bun run lint:check",
    "dev-tools:check": "bunx tsx scripts/dev-tools-check.ts",
    "workflow": "bunx tsx scripts/dev-workflow.ts",
    "health": "bunx tsx scripts/health-check.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bunx playwright test",
    "test:e2e:headed": "bunx playwright test --headed",
    "test:e2e:ui": "bunx playwright test --ui",
    "test:e2e:auth": "bunx playwright test tests/e2e/playwright/auth",
    "test:e2e:routing": "bunx playwright test tests/e2e/playwright/routing"
  },
  "overrides": {
    "brace-expansion": "^5.0.6",
    "dompurify": "^3.4.8",
    "flatted": "^3.4.2",
    "js-cookie": "^3.0.8",
    "picomatch": "^4.0.4",
    "postcss": "^8.5.15",
    "vite": "^7.3.2"
  },
  "dependencies": {
    "@tanstack/vue-virtual": "^3.13.35",
    "@vueuse/core": "^14.4.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.12",
    "html2canvas": "^1.4.1",
    "js-cookie": "^3.0.8",
    "jspdf": "^4.2.1",
    "jwt-decode": "^4.0.0",
    "lodash-es": "^4.18.1",
    "lunr": "^2.3.9",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/forms": "^0.5.11",
    "@types/lodash-es": "^4.17.12",
    "@types/lunr": "^2.3.7",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.19",
    "terser": "^5.49.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vite-bundle-analyzer": "^1.3.9",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.8"
  }
}
