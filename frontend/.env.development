# ============================================================================
# 開發環境配置 - Layer 1: 環境變量層
# ============================================================================
# 本文件用於本地開發環境
# 注意: 本地開發連接到遠程生產資源 (Remote-Only 策略)

# ----------------------------------------------------------------------------
# 核心 URL 配置
# ----------------------------------------------------------------------------
# 後端 API 基礎 URL (Worker 域名)
VITE_BACKEND_URL=https://mcis-backend.daiwandist.com

# Vite Proxy 目標 URL (開發環境用)
# 此變量用於 vite.config.ts 的 proxy 配置
VITE_API_BASE_URL=https://mcis-backend.daiwandist.com

# 前端 URL (用於 CORS 驗證)
VITE_FRONTEND_URL=http://localhost:3000

# WebSocket URL (自動從 BACKEND_URL 推導，除非需要覆蓋)
VITE_WEBSOCKET_URL=wss://mcis-backend.daiwandist.com

# R2 存儲公開 URL (文件訪問)
VITE_STORAGE_PUBLIC_URL=https://s3.daiwandist.com

# ----------------------------------------------------------------------------
# 環境標識
# ----------------------------------------------------------------------------
VITE_ENV=development
VITE_DEV_MODE=true

# ----------------------------------------------------------------------------
# 調試與日誌配置
# ----------------------------------------------------------------------------
VITE_ENABLE_DEBUG_LOGS=true
VITE_DEBUG=true
VITE_WEBSOCKET_DEBUG=true

# ----------------------------------------------------------------------------
# WebSocket 配置
# ----------------------------------------------------------------------------
VITE_WEBSOCKET_ENABLED=true
VITE_WEBSOCKET_AUTO_RECONNECT=true
VITE_WEBSOCKET_RECONNECT_DELAY=5000
VITE_WEBSOCKET_MAX_RETRIES=5

# ----------------------------------------------------------------------------
# 功能開關
# ----------------------------------------------------------------------------
VITE_ENABLE_SEARCH_CACHE=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_EXPERIMENTAL_FEATURES=true
