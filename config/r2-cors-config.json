{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://multi-channel-platform-frontend.pages.dev",
          "https://your-api-domain.example.com",
          "https://your-storage-domain.example.com",
          "http://localhost:3000",
          "http://localhost:3001",
          "http://localhost:3002",
          "http://localhost:3003",
          "http://localhost:3004",
          "http://localhost:3005",
          "http://localhost:3006",
          "http://localhost:3007",
          "http://localhost:3008",
          "http://localhost:3009",
          "http://localhost:3010",
          "http://127.0.0.1:3000",
          "http://127.0.0.1:3001",
          "http://127.0.0.1:3002",
          "http://127.0.0.1:3003",
          "http://127.0.0.1:3004",
          "http://127.0.0.1:3005",
          "http://127.0.0.1:3006",
          "http://127.0.0.1:3007",
          "http://127.0.0.1:3008",
          "http://127.0.0.1:3009",
          "http://127.0.0.1:3010"
        ],
        "methods": [
          "GET",
          "PUT",
          "HEAD",
          "DELETE"
        ],
        "headers": [
          "content-type",
          "content-length",
          "x-amz-content-sha256",
          "x-amz-date",
          "authorization",
          "cache-control",
          "x-requested-with"
        ]
      },
      "exposeHeaders": [
        "ETag",
        "Content-Length",
        "Content-Type"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
