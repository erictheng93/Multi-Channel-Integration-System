# Terraform 部署環境變數範例
# 專用於 user-deploy.ps1 腳本的環境變數設定
# 複製此檔案為 .env.terraform 並填入實際值

# ========================================
# 必要環境變數 (Required)
# ========================================

# Cloudflare API Token (必須有 Workers, D1, R2, KV, Pages 權限)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# LINE Bot Messaging API 設定
TF_VAR_line_channel_access_token=your_line_channel_access_token
TF_VAR_line_channel_secret=your_line_channel_secret

# 系統管理員帳戶 (首次登入使用)
TF_VAR_admin_email=admin@yourdomain.com
TF_VAR_admin_password=your_secure_password_min_8_chars

# ========================================
# 可選環境變數 (Optional)
# ========================================

# Cloudflare 帳戶 ID (如果未設定，腳本會自動偵測)
# TF_VAR_cloudflare_account_id=your_cloudflare_account_id

# Facebook Messenger 整合 (如果需要 Facebook 支援)
# TF_VAR_facebook_page_access_token=your_facebook_page_access_token
# TF_VAR_facebook_app_secret=your_facebook_app_secret

# 自訂域名設定
# TF_VAR_custom_domain=api.yourdomain.com
# TF_VAR_frontend_custom_domain=app.yourdomain.com
# TF_VAR_zone_id=your_cloudflare_zone_id

# 專案配置
# TF_VAR_project_name=multi-channel-platform
# TF_VAR_environment=production

# R2 存儲位置 (WNAM, ENAM, WEUR, EEUR, APAC)
# TF_VAR_r2_location=APAC

# 功能開關
# TF_VAR_enable_facebook_integration=false
# TF_VAR_enable_advanced_features=true

# 資源配置
# TF_VAR_worker_cpu_limit=50
# TF_VAR_worker_memory_limit=128

# ========================================
# 使用說明
# ========================================

# 1. 複製此檔案並重命名為 .env.terraform
# 2. 填入你的實際值 (移除範例中的註解 #)
# 3. 在 PowerShell 中載入環境變數：
#    Get-Content .env.terraform | ForEach-Object { 
#        if($_ -match '^([^=]+)=(.*)$') { 
#            [Environment]::SetEnvironmentVariable($matches[1], $matches[2], "Process") 
#        } 
#    }
# 4. 執行部署：.\scripts\user-deploy.ps1

# ========================================
# 安全提醒
# ========================================

# ⚠️  重要：
# - 此檔案包含敏感認證資訊
# - 請勿提交到版本控制系統
# - 確保 .gitignore 包含 .env* 規則
# - 定期輪換 API Token 和密碼