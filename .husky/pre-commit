# Ensure bun is in PATH
export PATH="$HOME/.bun/bin:$PATH"

echo "🔍 Running pre-commit checks (fast, parallel)..."
echo "   (full TS/ESLint runs on git push)"

# Temp files for parallel job output
TMPDIR="${TMPDIR:-/tmp}"
LOG_IMPORT="$TMPDIR/mcis-precommit-import.log"
LOG_ROUTES="$TMPDIR/mcis-precommit-routes.log"
LOG_SQL="$TMPDIR/mcis-precommit-sql.log"
EXIT_IMPORT="$TMPDIR/mcis-precommit-import.exit"
EXIT_ROUTES="$TMPDIR/mcis-precommit-routes.exit"
EXIT_SQL="$TMPDIR/mcis-precommit-sql.exit"
LOG_SECRETS="$TMPDIR/mcis-precommit-secrets.log"
EXIT_SECRETS="$TMPDIR/mcis-precommit-secrets.exit"
LOG_BP="$TMPDIR/mcis-precommit-breakpoints.log"
EXIT_BP="$TMPDIR/mcis-precommit-breakpoints.exit"
LOG_BTN="$TMPDIR/mcis-precommit-scoped-btn.log"
EXIT_BTN="$TMPDIR/mcis-precommit-scoped-btn.exit"

START=$(date +%s)

# Job 1: Import path check (prevent deep relative paths)
(
  bun scripts/check-import-paths.ts > "$LOG_IMPORT" 2>&1
  echo $? > "$EXIT_IMPORT"
) &
PID_IMPORT=$!

# Job 2: Route conflict check (prevent route ordering issues)
(
  bun run check:routes:ci > "$LOG_ROUTES" 2>&1
  echo $? > "$EXIT_ROUTES"
) &
PID_ROUTES=$!

# Job 3: Unsafe sql.raw() check (prevent SQL injection regressions)
(
  bun run check:sql-raw:ci > "$LOG_SQL" 2>&1
  echo $? > "$EXIT_SQL"
) &
PID_SQL=$!

# Job 4: Secret scan of staged changes (rules in .gitleaks.toml)
(
  if command -v gitleaks > /dev/null 2>&1; then
    gitleaks git --pre-commit --staged --redact --no-banner -c .gitleaks.toml > "$LOG_SECRETS" 2>&1
  else
    echo "gitleaks is not installed: winget install Gitleaks.Gitleaks (Windows) / brew install gitleaks (macOS)" > "$LOG_SECRETS"
    false
  fi
  echo $? > "$EXIT_SECRETS"
) &
PID_SECRETS=$!

# Job 5: Responsive breakpoint scale (frontend/src/config/breakpoints.ts)
(
  (cd frontend && bun run lint:breakpoints) > "$LOG_BP" 2>&1
  echo $? > "$EXIT_BP"
) &
PID_BP=$!

# Job 6: Global .btn system guard (no scoped redefinitions, no modifier without base)
(
  (cd frontend && bun run lint:scoped-btn) > "$LOG_BTN" 2>&1
  echo $? > "$EXIT_BTN"
) &
PID_BTN=$!

# Wait for all six to finish
wait $PID_IMPORT $PID_ROUTES $PID_SQL $PID_SECRETS $PID_BP $PID_BTN

END=$(date +%s)
ELAPSED=$((END - START))

# Collect results
FAIL=0

if [ "$(cat "$EXIT_IMPORT")" != "0" ]; then
  echo ""
  echo "── Import path check ──────────────────────────────"
  cat "$LOG_IMPORT"
  echo "⚠️  Import path check failed (use --no-verify to bypass)"
  FAIL=1
fi

if [ "$(cat "$EXIT_ROUTES")" != "0" ]; then
  echo ""
  echo "── Route conflict check ───────────────────────────"
  cat "$LOG_ROUTES"
  echo "❌ Route conflict detected! Please fix before committing."
  echo "💡 Run 'bun run check:routes' for detailed report"
  FAIL=1
fi

if [ "$(cat "$EXIT_SQL")" != "0" ]; then
  echo ""
  echo "── sql.raw safety check ───────────────────────────"
  cat "$LOG_SQL"
  echo "❌ Unsafe sql.raw() detected! See report above."
  echo "💡 Rewrite using Drizzle query builder or add a justified suppression comment"
  FAIL=1
fi

if [ "$(cat "$EXIT_SECRETS")" != "0" ]; then
  echo ""
  echo "── Secret scan (gitleaks) ─────────────────────────"
  cat "$LOG_SECRETS"
  echo "Possible secret in staged changes. Move it to an env var or wrangler secret."
  echo "False positive? Add an allowlist entry to .gitleaks.toml"
  FAIL=1
fi

if [ "$(cat "$EXIT_BP")" != "0" ]; then
  echo ""
  echo "── Breakpoint scale check ─────────────────────────"
  cat "$LOG_BP"
  echo "Use a width from frontend/src/config/breakpoints.ts (480/640/768/1024/1280)."
  FAIL=1
fi

if [ "$(cat "$EXIT_BTN")" != "0" ]; then
  echo ""
  echo "── Button system check ────────────────────────────"
  cat "$LOG_BTN"
  echo "The .btn system lives only in frontend/src/style.css; see CLAUDE.md 'Button System'."
  FAIL=1
fi

if [ $FAIL -ne 0 ]; then
  exit 1
fi

echo "✅ Pre-commit checks passed in ${ELAPSED}s (full type-check/lint runs on push)"
