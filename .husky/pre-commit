# Ensure bun is in PATH
export PATH="$HOME/.bun/bin:$PATH"

echo "🔍 Running pre-commit checks..."

# Check import paths (prevent deep relative paths)
echo "Checking import paths..."
bunx tsx scripts/check-import-paths.ts
if [ $? -ne 0 ]; then
  echo "⚠️  Import path check failed (use --no-verify to bypass)"
  exit 1
fi

# Check route conflicts (prevent route ordering issues)
echo "🛤️  Checking route conflicts..."
bun run check:routes:ci
if [ $? -ne 0 ]; then
  echo "❌ Route conflict detected! Please fix before committing."
  echo "💡 Run 'bun run check:routes' for detailed report"
  exit 1
fi

# Backend TypeScript check
echo "Checking backend TypeScript..."
bunx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ Backend TypeScript compilation failed!"
  exit 1
fi

# Frontend checks
echo "Checking frontend TypeScript and ESLint..."
cd frontend

# Frontend TypeScript check
bunx vue-tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ Frontend TypeScript compilation failed!"
  exit 1
fi

# ESLint check
bun run lint:check
if [ $? -ne 0 ]; then
  echo "❌ ESLint check failed!"
  exit 1
fi

cd ..

echo "✅ All pre-commit checks passed!"
