echo "🔍 Running pre-commit checks..."

# Check import paths (prevent deep relative paths)
echo "Checking import paths..."
npx tsx scripts/check-import-paths.ts
if [ $? -ne 0 ]; then
  echo "⚠️  Import path check failed (use --no-verify to bypass)"
  exit 1
fi

# Backend TypeScript check
echo "Checking backend TypeScript..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ Backend TypeScript compilation failed!"
  exit 1
fi

# Frontend checks
echo "Checking frontend TypeScript and ESLint..."
cd frontend

# Frontend TypeScript check
npx vue-tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ Frontend TypeScript compilation failed!"
  exit 1
fi

# ESLint check with strict warning limit (0 warnings allowed)
npm run lint -- --max-warnings 0
if [ $? -ne 0 ]; then
  echo "❌ ESLint check failed! No warnings allowed in committed code."
  exit 1
fi

cd ..

echo "✅ All pre-commit checks passed!"