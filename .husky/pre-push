# Ensure bun is in PATH
export PATH="$HOME/.bun/bin:$PATH"

# Allow bypass with `git push --no-verify` (same as pre-commit).
# Skip on delete-only pushes (no commits to check).
ZERO="0000000000000000000000000000000000000000"
ANY_NEW=0
CHANGED=""
RANGE_UNKNOWN=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue   # branch deletion, nothing to check
  ANY_NEW=1

  if [ "$remote_sha" != "$ZERO" ] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    BASE="$remote_sha"
  else
    # New remote ref (or a base we don't have locally): fall back to the oldest
    # commit that isn't reachable from any origin ref.
    OLDEST=$(git rev-list "$local_sha" --not --remotes=origin 2>/dev/null | tail -n 1)
    BASE=$(git rev-parse --verify --quiet "${OLDEST}^" 2>/dev/null)
  fi

  if [ -z "$BASE" ]; then
    RANGE_UNKNOWN=1   # can't tell what's being pushed — assume it needs checking
    break
  fi

  CHANGED="$CHANGED
$(git diff --name-only "$BASE" "$local_sha")"
done

if [ "$ANY_NEW" = "0" ]; then
  echo "🔬 pre-push: only deletions, skipping checks"
  exit 0
fi

# ---------------------------------------------------------------------------
# Docs-only fast path
#
# The three checks below cover exactly: src/** + shared/** (tsc), frontend/**
# (vue-tsc + eslint). A push that touches none of those cannot change their
# result, so paying ~2-10 minutes for it is pure waste — and the structural
# guards in pre-commit have already run on every commit either way.
#
# The allowlist is deliberately narrow. docs/** is safe wholesale because the
# root tsconfig includes only src/** and shared/**, and eslint runs inside
# frontend/. Anything under a checked tree runs the full suite even when it is
# a .md file, so a doc living next to code is never the reason a check is
# skipped. Force the full run with FULL_CHECK=1 git push.
# ---------------------------------------------------------------------------
DOCS_ONLY=1
FILE_COUNT=0

if [ "$RANGE_UNKNOWN" = "1" ] || [ -n "$FULL_CHECK" ]; then
  DOCS_ONLY=0
else
  for f in $CHANGED; do
    FILE_COUNT=$((FILE_COUNT + 1))
    case "$f" in
      frontend/*|src/*|shared/*) DOCS_ONLY=0; break ;;
      docs/*|*.md|*.txt|LICENSE)  ;;
      *) DOCS_ONLY=0; break ;;
    esac
  done
  # An empty diff tells us nothing useful; run the checks.
  [ "$FILE_COUNT" = "0" ] && DOCS_ONLY=0
fi

if [ "$DOCS_ONLY" = "1" ]; then
  echo "📝 pre-push: ${FILE_COUNT} file(s) changed, all documentation"
  echo "   Skipping tsc / vue-tsc / eslint — no checked source touched."
  echo "   Force the full run with: FULL_CHECK=1 git push"
  exit 0
fi

echo "🔬 Running pre-push checks (full, parallel)..."
echo "   (tsc + vue-tsc + eslint running concurrently)"

# Ensure cache dirs exist for incremental tsc/vue-tsc/eslint
mkdir -p node_modules/.cache frontend/node_modules/.cache

TMPDIR="${TMPDIR:-/tmp}"
LOG_TSC="$TMPDIR/mcis-prepush-tsc.log"
LOG_VUETSC="$TMPDIR/mcis-prepush-vuetsc.log"
LOG_ESLINT="$TMPDIR/mcis-prepush-eslint.log"
EXIT_TSC="$TMPDIR/mcis-prepush-tsc.exit"
EXIT_VUETSC="$TMPDIR/mcis-prepush-vuetsc.exit"
EXIT_ESLINT="$TMPDIR/mcis-prepush-eslint.exit"

START=$(date +%s)

# Job 1: Backend TypeScript (incremental via tsBuildInfoFile)
(
  bunx tsc --noEmit > "$LOG_TSC" 2>&1
  echo $? > "$EXIT_TSC"
) &
PID_TSC=$!

# Job 2: Frontend TypeScript (vue-tsc, incremental)
(
  cd frontend && bunx vue-tsc --noEmit > "$LOG_VUETSC" 2>&1
  echo $? > "$EXIT_VUETSC"
) &
PID_VUETSC=$!

# Job 3: Frontend ESLint (with cache)
(
  # --max-warnings 0 mirrors CI's `bun run lint:check`; without it warnings
  # pass locally and only fail in GitHub Actions.
  cd frontend && bunx eslint . \
    --max-warnings 0 \
    --cache \
    --cache-location node_modules/.cache/eslint/ \
    --cache-strategy content \
    > "$LOG_ESLINT" 2>&1
  echo $? > "$EXIT_ESLINT"
) &
PID_ESLINT=$!

# Wait for all three
wait $PID_TSC $PID_VUETSC $PID_ESLINT

END=$(date +%s)
ELAPSED=$((END - START))

FAIL=0

if [ "$(cat "$EXIT_TSC")" != "0" ]; then
  echo ""
  echo "── Backend TypeScript (tsc) ───────────────────────"
  cat "$LOG_TSC"
  echo "❌ Backend TypeScript compilation failed!"
  FAIL=1
fi

if [ "$(cat "$EXIT_VUETSC")" != "0" ]; then
  echo ""
  echo "── Frontend TypeScript (vue-tsc) ──────────────────"
  cat "$LOG_VUETSC"
  echo "❌ Frontend TypeScript compilation failed!"
  FAIL=1
fi

if [ "$(cat "$EXIT_ESLINT")" != "0" ]; then
  echo ""
  echo "── Frontend ESLint ────────────────────────────────"
  cat "$LOG_ESLINT"
  echo "❌ ESLint check failed!"
  FAIL=1
fi

if [ $FAIL -ne 0 ]; then
  echo ""
  echo "💡 Bypass (NOT recommended): git push --no-verify"
  exit 1
fi

echo "✅ Pre-push checks passed in ${ELAPSED}s"
