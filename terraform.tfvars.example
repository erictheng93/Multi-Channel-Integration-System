# Terraform 變數配置範例
# 複製此檔案為 terraform.tfvars 並填入實際值

# Cloudflare 配置
cloudflare_account_id = "your-cloudflare-account-id"
zone_id              = "your-zone-id-if-using-custom-domain"

# 專案配置
project_name = "multi-channel-platform"
environment  = "production"

# LINE Bot 配置 (必填)
line_channel_access_token = "your-line-channel-access-token"
line_channel_secret      = "your-line-channel-secret"

# Facebook Messenger 配置 (可選)
facebook_page_access_token = "your-facebook-page-access-token"
facebook_app_secret       = "your-facebook-app-secret"

# 管理員帳戶配置
admin_email    = "admin@yourdomain.com"
admin_password = "your-secure-password"

# 域名配置 (可選)
custom_domain          = "api.yourdomain.com"
frontend_custom_domain = "app.yourdomain.com"

# R2 存儲配置
r2_location = "APAC"  # 選擇最接近用戶的區域

# 功能開關
enable_facebook_integration = false
enable_advanced_features   = true

# 資源配置
worker_cpu_limit    = 50   # 毫秒
worker_memory_limit = 128  # MB